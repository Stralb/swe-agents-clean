digraph schema {graph [rankdir=TB,splines=ortho,concentrate=false,pack=true,packmode="array_u3",nodesep=0.8,ranksep=1.2,pad=0.3,bgcolor="white",outputorder=edgesfirst];node [shape=plain,fontname="DejaVu Sans",fontsize=12];edge [color="#4d6789",penwidth=1.4,arrowsize=0.75];
"review_artifact_index" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>review_artifact_index</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">artifact_key</TD><TD>TEXT</TD></TR></TABLE>>];
"review_claim_history" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>review_claim_history</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">evidence_id</TD><TD>TEXT</TD></TR></TABLE>>];
