"review_relationship_catalog" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>review_relationship_catalog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">child_table</TD><TD>TEXT</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">foreign_key_id</TD><TD>INTEGER</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">column_sequence</TD><TD>INTEGER</TD></TR></TABLE>>];
"review_run_catalog" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>review_run_catalog</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK</TD><TD ALIGN="LEFT">run_id</TD><TD>TEXT</TD></TR></TABLE>>];
"review_table_catalog" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>review_table_catalog</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">table_name</TD><TD>TEXT</TD></TR></TABLE>>];
