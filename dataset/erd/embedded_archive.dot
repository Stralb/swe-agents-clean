digraph schema {graph [rankdir=TB,splines=ortho,concentrate=false,pack=true,packmode="array_u3",nodesep=0.8,ranksep=1.2,pad=0.3,bgcolor="white",outputorder=edgesfirst];node [shape=plain,fontname="DejaVu Sans",fontsize=12];edge [color="#4d6789",penwidth=1.4,arrowsize=0.75];
"study_archive_vault_chunks" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_archive_vault_chunks</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK</TD><TD ALIGN="LEFT">object_key</TD><TD>TEXT</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">sequence</TD><TD>INTEGER</TD></TR></TABLE>>];
"study_archive_vault_members" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_archive_vault_members</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">archive_name</TD><TD>TEXT</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">member_path</TD><TD>TEXT</TD></TR></TABLE>>];
"study_archive_vault_metadata" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_archive_vault_metadata</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">key</TD><TD>TEXT</TD></TR></TABLE>>];
"study_archive_vault_objects" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_archive_vault_objects</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">object_key</TD><TD>TEXT</TD></TR></TABLE>>];
"study_archive_vault_sources" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_archive_vault_sources</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK</TD><TD ALIGN="LEFT">source_key</TD><TD>TEXT</TD></TR></TABLE>>];
"study_sources" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#e8eef6"><B>study_sources</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">source_key</TD><TD>TEXT</TD></TR></TABLE>>];
