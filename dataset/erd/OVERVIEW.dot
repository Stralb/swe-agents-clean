"study_classifications" [label=<<TABLE BORDER="1" COLOR="#70849d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#d7e9ff"><B>study_classifications</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK</TD><TD ALIGN="LEFT">case_id</TD><TD>INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">imported_source_key</TD><TD>TEXT</TD></TR></TABLE>>];
