}




def _current_codeql_error_count(
    db_path: str,
) -> int:
    """Count only current terminal CodeQL job errors."""

    connection = sqlite3.connect(
        f"file:{db_path}?mode=ro",
        uri=True,
        timeout=10,
    )

    try:
        row = connection.execute(
            """
            SELECT
                COUNT(*)
            FROM scanner_jobs
            WHERE job_type='codeql_security'
              AND LOWER(
                    COALESCE(
                        status,
                        ''
                    )
                  ) IN (
                    'error',
                    'failed',
                    'failure',
                    'timeout',
                    'timed_out',
                    'blocked',
                    'crashed'
                  )
            """
        ).fetchone()

        return int(
            row[0]
            or 0
        )

    finally:
        connection.close()


def _apply_current_codeql_error_count(
    payload: object,
    error_count: int,
) -> int:
    """Update CodeQL error counters in an Overview payload."""

    applied = 0
    visited: set[int] = set()

    def visit(
        value: object,
        key_hint: str = "",
    ) -> None:
        nonlocal applied

        identity = id(
            value
        )

        if identity in visited:
            return

        if isinstance(
            value,
            dict,
        ):
            visited.add(
                identity
            )

            scanner = str(
                value.get(
                    "scanner",
                    "",
                )
                or value.get(
                    "key",
                    "",
                )
                or key_hint
                or ""
            ).strip().lower().replace(
                "_",
                "-",
            )

            if (
                scanner == "codeql"
                and "errors" in value
            ):
                value["errors"] = int(
                    error_count
                )

                applied += 1

            for key, child in value.items():
                visit(
                    child,
                    str(
                        key
                    ),
                )

        elif isinstance(
            value,
            list,
        ):
            visited.add(
                identity
            )

            for child in value:
                visit(
                    child,
                    key_hint,
                )

    visit(
        payload
    )

    return applied
