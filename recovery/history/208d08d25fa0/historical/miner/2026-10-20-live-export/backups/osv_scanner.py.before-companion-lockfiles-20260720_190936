from __future__ import annotations

import json
import shutil
import tempfile
from pathlib import Path, PurePosixPath
from typing import Any

from src.scanners.dependency_diff import _parse_added_removed, is_dependency_file
from src.utils.shell import parse_json_maybe, run_cmd


def _dependency_state_lines(patch: str, *, after: bool) -> list[str]:
    """Return changed dependency lines for before/after states from a unified diff."""
    lines: list[str] = []
    prefix = "+" if after else "-"
    skip_prefix = "+++" if after else "---"
    for line in (patch or "").splitlines():
        if line.startswith(skip_prefix) or line.startswith("@@"):
            continue
        if not line.startswith(prefix):
            continue
        body = line[1:]
        if body.strip() and not body.lstrip().startswith("#"):
            lines.append(body)
    return lines


def _write_dependency_delta_files(root: Path, files: list[dict[str, Any]], *, after: bool) -> bool:
    wrote = False
    for f in files:
        filename = f.get("filename") or ""
        if not is_dependency_file(filename):
            continue
        state_lines = _dependency_state_lines(f.get("patch") or "", after=after)
        if not state_lines:
            continue
        target = root / Path(filename).name
        target.write_text("\n".join(state_lines), encoding="utf-8")
        wrote = True
    return wrote


def _scan_dir(
    root: Path,
    *,
    timeout_seconds: int = 240,
) -> tuple[list[dict[str, Any]], dict[str, str]]:
    """Scan a complete dependency snapshot directory with OSV."""

    out = run_cmd(
        [
            "osv-scanner",
            "scan",
            "source",
            "--recursive",
            "--no-ignore",
            "--allow-no-lockfiles",
            "--format",
            "json",
            str(root),
        ],
        timeout=timeout_seconds,
    )

    stdout = out.get("stdout", "") or ""
    stderr = out.get("stderr", "") or ""
    data = parse_json_maybe(stdout)

    findings: list[dict[str, Any]] = []

    if isinstance(data, dict):
        for result in data.get("results", []) or []:
            source_path = str(
                ((result.get("source") or {}).get("path"))
                or ""
            )

            if source_path:
                try:
                    source_path = str(
                        Path(source_path)
                        .resolve()
                        .relative_to(root.resolve())
                    )
                except Exception:
                    source_path = source_path.replace(
                        "\\\\",
                        "/",
                    )

            for package in result.get("packages", []) or []:
                pkg = package.get("package", {}) or {}

                for vuln in (
                    package.get("vulnerabilities", [])
                    or []
                ):
                    findings.append({
                        "file": source_path,
                        "package": pkg.get("name"),
                        "version": pkg.get("version"),
                        "vuln_id": vuln.get("id"),
                        "description": (
                            vuln.get("summary")
                            or vuln.get("details")
                            or "Known vulnerable dependency"
                        ),
                        "raw": vuln,
                    })

    lower_stderr = stderr.lower()

    if "could not extract" in lower_stderr:
        status = "parse_failed"
    elif "error during extraction" in lower_stderr:
        status = "parse_failed"
    elif "no package sources found" in lower_stderr:
        # The snapshot was fetched and OSV was executed, but OSV could
        # not derive packages from the available manifest types. This is
        # a completed scan with a warning, not an inapplicable case.
        status = "ok_with_warnings"
    elif isinstance(data, dict):
        # OSV commonly exits non-zero when vulnerabilities are found.
        status = "ok"
    elif out.get("returncode") == 124:
        status = "timeout"
    elif out.get("ok"):
        status = "ok"
    else:
        status = "error"

    return findings, {
        "status": status,
        "stdout": stdout,
        "stderr": stderr,
    }


def _advisory_ids(f: dict[str, Any]) -> tuple[str, ...]:
    """Return all equivalent advisory identifiers known for an OSV finding.

    OSV may report the same vulnerability twice under IDs such as PYSEC-* and
    GHSA-*. Treat aliases/related IDs as the same advisory family so the UI does
    not show duplicate dependency regressions.
    """
    ids: set[str] = set()
    for key in ("vuln_id", "id"):
        value = f.get(key)
        if value:
            ids.add(str(value))
    raw = f.get("raw") or {}
    if isinstance(raw, dict):
        if raw.get("id"):
            ids.add(str(raw.get("id")))
        for key in ("aliases", "related"):
            values = raw.get(key) or []
            if isinstance(values, str):
                ids.add(values)
            elif isinstance(values, list):
                ids.update(str(v) for v in values if v)
    return tuple(sorted(ids))


def _finding_key(f: dict[str, Any]) -> tuple[str, tuple[str, ...]]:
    # Do not include temp directory paths or version in the identity. We compare
    # whether the same package advisory family already affected the before state.
    return (str(f.get("package") or "").lower(), _advisory_ids(f))



def _normalise_dependency_path(value: Any) -> str:
    path = str(value or "").replace("\\", "/").lstrip("/")
    parts = PurePosixPath(path).parts

    if (
        not path
        or not parts
        or any(part in {"", ".", ".."} for part in parts)
    ):
        return ""

    return "/".join(parts)


def _dependency_paths_for_snapshot(
    files: list[dict[str, Any]],
    *,
    after: bool,
) -> list[str]:
    """Return dependency paths that exist in the requested PR state."""

    paths: list[str] = []
    seen: set[str] = set()

    for file_row in files:
        status = str(file_row.get("status") or "").lower()

        if after:
            if status == "removed":
                continue
            candidate = file_row.get("filename")
        else:
            if status == "added":
                continue
            candidate = (
                file_row.get("previous_filename")
                if status == "renamed"
                else file_row.get("filename")
            )

        normalised = _normalise_dependency_path(candidate)

        if (
            not normalised
            or normalised in seen
            or not is_dependency_file(normalised)
        ):
            continue

        seen.add(normalised)
        paths.append(normalised)

    return paths


def _rename_aliases(
    files: list[dict[str, Any]],
) -> dict[str, str]:
    """Map renamed head paths back to their base-state paths."""

    aliases: dict[str, str] = {}

    for file_row in files:
        if str(file_row.get("status") or "").lower() != "renamed":
            continue

        head_path = _normalise_dependency_path(
            file_row.get("filename")
        )
        base_path = _normalise_dependency_path(
            file_row.get("previous_filename")
        )

        if head_path and base_path:
            aliases[head_path] = base_path

    return aliases


def _materialize_git_snapshot(
    repo_dir: Path,
    sha: str,
    dependency_paths: list[str],
    destination: Path,
    *,
    timeout_seconds: int,
) -> tuple[list[str], list[str], list[str]]:
    """Write complete manifest contents from one commit into a snapshot."""

    written: list[str] = []
    absent: list[str] = []
    errors: list[str] = []

    for relative_path in dependency_paths:
        result = run_cmd(
            [
                "git",
                "show",
                f"{sha}:{relative_path}",
            ],
            cwd=repo_dir,
            timeout=min(timeout_seconds, 120),
        )

        if not result.get("ok"):
            stderr = str(result.get("stderr") or "")
            lower = stderr.lower()

            expected_absence = (
                "does not exist in" in lower
                or "exists on disk, but not in" in lower
                or "path '" in lower and "does not exist" in lower
            )

            if expected_absence:
                absent.append(relative_path)
            else:
                errors.append(
                    f"{relative_path}: {stderr[-500:]}"
                )

            continue

        target = destination.joinpath(
            *PurePosixPath(relative_path).parts
        )
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(
            str(result.get("stdout") or ""),
            encoding="utf-8",
        )
        written.append(relative_path)

    return written, absent, errors


def _snapshot_finding_key(
    finding: dict[str, Any],
    *,
    path_aliases: dict[str, str] | None = None,
) -> tuple[str, str, tuple[str, ...]]:
    path = _normalise_dependency_path(
        finding.get("file")
    )

    if path_aliases:
        path = path_aliases.get(path, path)

    return (
        path.lower(),
        str(finding.get("package") or "").lower(),
        _advisory_ids(finding),
    )


def _snapshot_status(
    base_status: str,
    head_status: str,
) -> str:
    statuses = {base_status, head_status}

    for severe in (
        "error",
        "tool_missing",
        "timeout",
        "parse_failed",
    ):
        if severe in statuses:
            return severe

    if "ok_with_warnings" in statuses:
        return "ok_with_warnings"

    return "ok"


def scan_dependency_snapshots(
    repo_url: str,
    base_sha: str,
    head_sha: str,
    files: list[dict[str, Any]],
    *,
    timeout_seconds: int = 300,
) -> tuple[
    list[dict[str, Any]],
    dict[str, str],
    dict[str, str],
    dict[str, str],
]:
    """Compare complete dependency manifests at PR base and head."""

    dependency_files = [
        file_row
        for file_row in files
        if is_dependency_file(
            str(file_row.get("filename") or "")
        )
        or is_dependency_file(
            str(file_row.get("previous_filename") or "")
        )
    ]

    if not dependency_files:
        meta = {
            "status": "not_applicable",
            "stdout": "",
            "stderr": "No dependency manifest or lock files changed",
        }
        return [], meta, dict(meta), dict(meta)

    if not repo_url or not base_sha or not head_sha:
        meta = {
            "status": "not_applicable",
            "stdout": "",
            "stderr": "Missing repo_url, base_sha or head_sha",
        }
        return [], meta, dict(meta), dict(meta)

    if not shutil.which("git"):
        meta = {
            "status": "tool_missing",
            "stdout": "",
            "stderr": "git executable not found on PATH",
        }
        return [], meta, dict(meta), dict(meta)

    if not shutil.which("osv-scanner"):
        meta = {
            "status": "tool_missing",
            "stdout": "",
            "stderr": "osv-scanner executable not found on PATH",
        }
        return [], meta, dict(meta), dict(meta)

    base_paths = _dependency_paths_for_snapshot(
        dependency_files,
        after=False,
    )
    head_paths = _dependency_paths_for_snapshot(
        dependency_files,
        after=True,
    )

    with tempfile.TemporaryDirectory() as temp_dir:
        root = Path(temp_dir)
        repo_dir = root / "repo"
        base_root = root / "base"
        head_root = root / "head"

        base_root.mkdir(parents=True, exist_ok=True)
        head_root.mkdir(parents=True, exist_ok=True)

        clone = run_cmd(
            [
                "git",
                "clone",
                "--depth",
                "1",
                "--no-checkout",
                repo_url,
                str(repo_dir),
            ],
            cwd=root,
            timeout=min(timeout_seconds, 300),
        )

        if not clone.get("ok"):
            meta = {
                "status": "error",
                "stdout": str(clone.get("stdout") or ""),
                "stderr": (
                    "git clone failed:\n"
                    + str(clone.get("stderr") or "")
                ),
            }
            return [], meta, dict(meta), dict(meta)

        fetch_errors: list[str] = []

        for label, sha in (
            ("base", base_sha),
            ("head", head_sha),
        ):
            fetch = run_cmd(
                [
                    "git",
                    "fetch",
                    "--depth",
                    "1",
                    "origin",
                    sha,
                ],
                cwd=repo_dir,
                timeout=min(timeout_seconds, 300),
            )

            if not fetch.get("ok"):
                fetch_errors.append(
                    f"{label} fetch failed for {sha}: "
                    f"{str(fetch.get('stderr') or '')[-1000:]}"
                )

        if fetch_errors:
            meta = {
                "status": "error",
                "stdout": "",
                "stderr": "\n".join(fetch_errors),
            }
            return [], meta, dict(meta), dict(meta)

        base_written, base_absent, base_errors = (
            _materialize_git_snapshot(
                repo_dir,
                base_sha,
                base_paths,
                base_root,
                timeout_seconds=timeout_seconds,
            )
        )

        head_written, head_absent, head_errors = (
            _materialize_git_snapshot(
                repo_dir,
                head_sha,
                head_paths,
                head_root,
                timeout_seconds=timeout_seconds,
            )
        )

        if base_errors or head_errors:
            meta = {
                "status": "error",
                "stdout": "",
                "stderr": json.dumps({
                    "base_materialization_errors": base_errors,
                    "head_materialization_errors": head_errors,
                }),
            }
            return [], meta, dict(meta), dict(meta)

        if base_written:
            base_findings, base_scan_meta = _scan_dir(
                base_root,
                timeout_seconds=timeout_seconds,
            )
        else:
            base_findings = []
            base_scan_meta = {
                "status": "ok",
                "stdout": "",
                "stderr": "No dependency files existed at base",
            }

        if head_written:
            head_findings, head_scan_meta = _scan_dir(
                head_root,
                timeout_seconds=timeout_seconds,
            )
        else:
            head_findings = []
            head_scan_meta = {
                "status": "ok",
                "stdout": "",
                "stderr": "No dependency files existed at head",
            }

        aliases = _rename_aliases(dependency_files)

        base_keys = {
            _snapshot_finding_key(finding)
            for finding in base_findings
        }

        introduced: list[dict[str, Any]] = []
        seen_head: set[
            tuple[str, str, tuple[str, ...]]
        ] = set()

        for finding in head_findings:
            key = _snapshot_finding_key(
                finding,
                path_aliases=aliases,
            )

            if key in base_keys or key in seen_head:
                continue

            seen_head.add(key)

            introduced_finding = dict(finding)
            introduced_finding["change_type"] = (
                "introduced_vulnerable_dependency"
            )
            introduced_finding["diff_linked"] = True

            if key[2]:
                introduced_finding["advisory_aliases"] = list(
                    key[2]
                )

            introduced.append(introduced_finding)

        base_meta = {
            "status": str(
                base_scan_meta.get("status") or "ok"
            ),
            "stdout": json.dumps({
                "sha": base_sha,
                "requested_paths": base_paths,
                "materialized_paths": base_written,
                "absent_paths": base_absent,
                "finding_count": len(base_findings),
                "osv_stdout": base_scan_meta.get("stdout", ""),
            }),
            "stderr": str(
                base_scan_meta.get("stderr") or ""
            ),
        }

        head_meta = {
            "status": str(
                head_scan_meta.get("status") or "ok"
            ),
            "stdout": json.dumps({
                "sha": head_sha,
                "requested_paths": head_paths,
                "materialized_paths": head_written,
                "absent_paths": head_absent,
                "finding_count": len(head_findings),
                "osv_stdout": head_scan_meta.get("stdout", ""),
            }),
            "stderr": str(
                head_scan_meta.get("stderr") or ""
            ),
        }

        summary_meta = {
            "status": _snapshot_status(
                base_meta["status"],
                head_meta["status"],
            ),
            "stdout": json.dumps({
                "base_findings": len(base_findings),
                "head_findings": len(head_findings),
                "introduced": len(introduced),
                "base_materialized": len(base_written),
                "head_materialized": len(head_written),
            }),
            "stderr": (
                "base: "
                + base_meta["stderr"][:1500]
                + "\nhead: "
                + head_meta["stderr"][:1500]
            ),
        }

        return introduced, summary_meta, base_meta, head_meta

def scan_dependency_patches(files: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], dict[str, str]]:
    """Run OSV over dependency deltas and report only introduced/worsened vulns.

    This compares the before and after dependency lines from the PR patch. A vuln
    that already affected the changed dependency before the PR is not promoted.
    This avoids treating harmless upgrades such as pytest 3.8.0 -> 3.8.1 as
    introduced vulnerabilities when both versions are in a later advisory range.
    """
    dep_files = [f for f in files if is_dependency_file(f.get("filename", ""))]
    if not dep_files:
        return [], {"status": "not_applicable", "stdout": "", "stderr": "No dependency files changed"}
    if not shutil.which("osv-scanner"):
        return [], {"status": "tool_missing", "stdout": "", "stderr": "osv-scanner executable not found on PATH"}

    with tempfile.TemporaryDirectory() as before_td, tempfile.TemporaryDirectory() as after_td:
        before_root = Path(before_td)
        after_root = Path(after_td)
        wrote_before = _write_dependency_delta_files(before_root, dep_files, after=False)
        wrote_after = _write_dependency_delta_files(after_root, dep_files, after=True)
        if not wrote_after:
            return [], {"status": "not_applicable", "stdout": "", "stderr": "No added/changed dependency lines to scan"}

        before_findings: list[dict[str, Any]] = []
        before_meta = {"status": "not_applicable", "stdout": "", "stderr": "No removed dependency lines to compare"}
        if wrote_before:
            before_findings, before_meta = _scan_dir(before_root)
        after_findings, after_meta = _scan_dir(after_root)

        before_keys = {_finding_key(f) for f in before_findings}
        introduced: list[dict[str, Any]] = []
        seen_after: set[tuple[str, tuple[str, ...]]] = set()
        for f in after_findings:
            key = _finding_key(f)
            if key in before_keys or key in seen_after:
                continue
            seen_after.add(key)
            f = dict(f)
            f["change_type"] = "introduced_or_worsened_vulnerable_dependency"
            if key[1]:
                f["advisory_aliases"] = list(key[1])
            introduced.append(f)

        status = after_meta.get("status", "ok")
        if before_meta.get("status") == "error" or after_meta.get("status") == "error":
            status = "error"
        stdout = json.dumps({
            "before_findings": len(before_findings),
            "after_findings": len(after_findings),
            "introduced_or_worsened": len(introduced),
        })
        stderr = "before: " + before_meta.get("stderr", "")[:2000] + "\nafter: " + after_meta.get("stderr", "")[:2000]
        return introduced, {"status": status, "stdout": stdout, "stderr": stderr}
