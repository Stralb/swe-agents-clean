# Published candidate Trivy 0.76.1 + separately mounted immutable OCI DB snapshot.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY repro_dependency_diff.txt /tmp/repro_dependency_diff.txt
RUN python -m pip install --require-hashes --only-binary=:all: --no-deps \
      -r /tmp/repro_dependency_diff.txt
COPY trivy /usr/local/bin/trivy
RUN chmod 0755 /usr/local/bin/trivy && trivy --version
WORKDIR /workspace
