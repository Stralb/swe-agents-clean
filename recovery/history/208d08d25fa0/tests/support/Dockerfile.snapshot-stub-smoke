# Ephemeral, synthetic-only OSV/Trivy original-runner smoke image.
# A base-image tag is NOT a fully immutable lock; do not feed actual target repos.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/repro_dependency_diff.txt /tmp/arno-dependency-requirements.txt
RUN python -m pip install --require-hashes --only-binary=:all: --no-deps \
    -r /tmp/arno-dependency-requirements.txt \
    && python -m pip freeze
WORKDIR /workspace
