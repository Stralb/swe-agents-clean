RUN mv /tmp/semgrep-candidate.whl /tmp/semgrep-1.181.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl \
    && python -m pip install --no-cache-dir /tmp/semgrep-1.181.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl \
    && semgrep --version \
    && python -m pip freeze > /opt/arno-semgrep-pip-freeze.txt \
    && rm -f /tmp/semgrep-1.181.0-cp310.cp311.cp312.cp313.cp314.py310.py311.py312.py313.py314-none-manylinux_2_34_x86_64.whl
