github:
  min_stars: 100
  language: JavaScript
  languages:
  - JavaScript
  - TypeScript
  strict_primary_language: false
  include_merged_prs: true
  include_closed_unmerged_prs: false
  search_query: language:JavaScript stars:>=100 archived:false
  per_page: 100
  min_remaining: 100
  search_min_interval_seconds: 8.0
  core_min_interval_seconds: 0.5
  request_jitter_seconds: 0.5
filters:
  english_only: true
  english_confidence_note: Uses langdetect on issue title + body. Non-English candidates
    are excluded.
  min_issue_words: 0
  issue_min_body_chars: 0
  exclude_bots:
  - dependabot[bot]
  - dependabot-preview[bot]
  - renovate[bot]
  - github-actions[bot]
  - pre-commit-ci[bot]
  - mergify[bot]
  - pyup[bot]
  - pyup-bot
  - linear[bot]
  exclude_docs_only: true
  exclude_docs_scope_only: true
  exclude_non_behaviour_only: true
  relevant_extensions:
  - .js
  - .jsx
  - .ts
  - .tsx
  - .mjs
  - .cjs
  - .mts
  - .cts
  - .json
  - .yml
  - .yaml
  - .lock
  relevant_paths:
  - package.json
  - package-lock.json
  - npm-shrinkwrap.json
  - yarn.lock
  - pnpm-lock.yaml
  - .github/workflows/
cache:
  github_api: true
  github_cache_dir: data/cache/github_agentic_js
  force_refresh: false
  force_rescan: false
collection:
  repository_eligibility_enabled: true
  min_js_ts_share: 0.50
  force_repo_eligibility_refresh: false
  ai_only: true
  lookback_start: '2025-11-01'
  lookback_months: 120
  require_pr_merged_after_lookback: true
  require_issue_created_after_lookback: false
  max_cases_per_repo: 0
  max_processed_prs_per_repo: 0
  max_prs_per_repo_per_query: 0
  max_new_prs_per_repo_per_run: 0
  max_raw_hits_per_repo_per_pass: 0
  targeted_per_page: 30
  targeted_max_pages: 1
  targeted_max_pages_total: 5
  targeted_pause_seconds: 2
  retrieval_mode: agentic_search
  repo_month_per_page: 50
  repo_month_max_pages: 2
  repo_window_per_page: 50
  repo_window_max_pages: 2
  repo_window_split_threshold: 100
  repo_window_exhaustive_split: false
  require_primary_worker: true
  require_high_yield_surface: false
  max_changed_files_for_evidence: 75
  max_linked_issues_per_pr_for_evidence: 1
  active_repo_seed: false
  active_repo_seed_max_pages: 2
  active_repo_seed_per_page: 100
  repo_universe_pushed_since: '2024-01-01'
  use_graphql_hydration: true
  require_graphql_same_repo_link: false
  require_issue_quality_filter: false
  repo_shard_count: 1
  repo_shard_index: 0
  month_shard_count: 1
  month_shard_index: 0
  repo_walk_enabled: false
  query_phases: []
  repo_sample_strategy: active_first
  case_sample_strategy: random
  random_seed: 42
  repo_sample_pool_multiplier: 4
  case_sample_pool_multiplier: 4
  ai_discovery: search
  fetch_commit_messages_for_ai: false
  fetch_pr_comments_for_issue_links: true
  fetch_commit_messages_for_issue_links: true
  ai_search:
    use_query_language_qualifier: false
    adaptive_date_partitioning: true
    adaptive_split_threshold: 900
    adaptive_search_per_page: 100
    adaptive_max_depth: 40
    profile: high
    max_marker_queries: 6
    max_pages_per_query: 5
    per_page: 30
    pause_seconds: 10
    secondary_wait_seconds: 60
    max_secondary_retries: 1
  require_javascript_typescript_surface: true
scan:
  ai_only: true
  codeql_max_per_run: 3
  methodology_note: 'Downstream-evidence-first: scan all valid same-repo issue-linked
    PRs with applicable approved workers; no Semgrep or issue-keyword gate.'
scanners:
  codeql: true
  gitleaks: true
  osv: true
  dependency_downgrade: true
  semgrep: true
  codeql_language: auto
  codeql_build_mode: none
  codeql_query_suite: null
  clone_depth: 1
  codeql_timeout_seconds: 600
  codeql_trigger: all_codeql
  semgrep_config: p/security-audit
  semgrep_timeout_seconds: 300
  performance_note: Default scan runs CodeQL for changed CodeQL-supported languages.
    Dependency and secret workers run by artifact applicability.
ai_markers:
  high_confidence:
  - codex/
  - devin-ai-integration[bot]
  - copilot/
  - cursor/
  - 'Co-Authored-By: Claude'
  - Generated with Claude Code
  medium_confidence: []
ui:
  page_title: Malicious Issue Miner
  rows_per_page: 50
workers:
  idle_seconds: 10
  max_loops: 0
  job_stale_minutes: 60
  codeql_stale_minutes: 180
