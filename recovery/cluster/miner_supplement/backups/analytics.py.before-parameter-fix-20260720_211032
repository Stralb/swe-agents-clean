from typing import Any

import altair as alt
import pandas as pd
import streamlit as st

from src.db.database import Database


def _json_value(raw: Any, default: Any) -> Any:
    if isinstance(raw, type(default)):
        return raw

    if raw in (None, ""):
        return default

    try:
        value = json.loads(str(raw))
    except Exception:
        return default

    return value if isinstance(value, type(default)) else default


def _feature_rows(db: Database) -> pd.DataFrame:
    case_rows = db.query(
        """
        SELECT
            c.id AS case_id,
            r.full_name AS repo,
            i.url AS issue_url,
            p.url AS pr_url
        FROM cases c
        JOIN repos r ON r.id = c.repo_id
        JOIN issues i ON i.id = c.issue_id
        JOIN pull_requests p ON p.id = c.pr_id
        ORDER BY c.id
        """
    )

    case_meta = {
        int(row["case_id"]): row
        for row in case_rows
    }

    records: list[dict[str, Any]] = []

    def add(
        case_id: int,
        family: str,
        feature: Any,
        source: str,
        path: Any = None,
        evidence,
        family: str,
        feature: Any,
        source: str,
        path: Any = None,
        evidence: Any = None,
        confidence: Any = None,
        scanner: Any = None,
        status: Any = None,
        details: Any = None,
    ) -> None:
        feature_text = str(feature or "").strip()

        if not feature_text:
            return

        meta = case_meta.get(int(case_id), {})

        records.append(
            {
                "case_id": int(case_id),
                "repo": meta.get("repo"),
                "family": family,
                "feature": feature_text,
                "feature_key": f"{family} → {feature_text}",
                "source": source,
                "path": path,
                "evidence": evidence,
                "confidence": confidence,
                "scanner": scanner,
                "status": status,
                "issue_url": meta.get("issue_url"),
                "pr_url": meta.get("pr_url"),
                "details": json.dumps(
                    details or {},
                    ensure_ascii=False,
                ),
            }
        )

    artifact_rows = db.query(
        """
        SELECT
            case_id,
            path,
            region,
            language,
            scanner_routes,
            confidence,
            evidence,
            mapping_version,
            generated,
            vendor
        FROM artifact_regions
        ORDER BY case_id, path
        """
    )

    for row in artifact_rows:
        case_id = int(row["case_id"])

        base_details = {
            "path": row.get("path"),
            "region": row.get("region"),
            "language": row.get("language"),
            "confidence": row.get("confidence"),
            "evidence": row.get("evidence"),
            "mapping_version": row.get("mapping_version"),
            "generated": row.get("generated"),
            "vendor": row.get("vendor"),
        }

        add(
            case_id,
            "Artifact region",
            row.get("region"),
            "artifact_regions.region",
            path=row.get("path"),
            evidence=row.get("evidence"),
            confidence=row.get("confidence"),
            details=base_details,
        )

        add(
            case_id,
            "Language",
            row.get("language"),
            "artifact_regions.language",
            path=row.get("path"),
            evidence=row.get("evidence"),
            confidence=row.get("confidence"),
            details=base_details,
        )

        routes = _json_value(
            row.get("scanner_routes"),
            [],
        )

        for route in routes:
            add(
                case_id,
                "Scanner route",
                route,
                "artifact_regions.scanner_routes",
                path=row.get("path"),
                evidence=row.get("evidence"),
                confidence=row.get("confidence"),
                details={
                    **base_details,
                    "route": route,
                },
            )

    case_features = db.query(
        """
        SELECT
            id AS case_id,
            ai_cohort,
            auto_tags,
            status
        FROM cases
        ORDER BY id
        """
    )

    for row in case_features:
        case_id = int(row["case_id"])

        add(
            case_id,
            "AI cohort",
            row.get("ai_cohort"),
            "cases.ai_cohort",
            status=row.get("status"),
            details={
                "ai_cohort": row.get("ai_cohort"),
                "status": row.get("status"),
            },
        )

        for tag in _json_value(
            row.get("auto_tags"),
            [],
        ):
            add(
                case_id,
                "Automatic tag",
                tag,
                "cases.auto_tags",
                status=row.get("status"),
                details={
                    "tag": tag,
                    "status": row.get("status"),
                },
            )

    upstream_rows = db.query(
        """
        SELECT
            c.id AS case_id,
            uf.feature_json
        FROM cases c
        JOIN upstream_features uf
          ON uf.issue_id = c.issue_id
        ORDER BY c.id
        """
    )

    for row in upstream_rows:
        feature_data = _json_value(
            row.get("feature_json"),
            {},
        )

        for name, value in feature_data.items():
            active = value is True

            if (
                not active
                and name.startswith("has_")
                and value == 1
            ):
                active = True

            if active:
                add(
                    int(row["case_id"]),
                    "Issue feature",
                    name,
                    "upstream_features.feature_json",
                    details={
                        "feature": name,
                        "value": value,
                    },
                )

    latest_runs = db.query(
        """
        SELECT
            sr.case_id,
            sr.scanner,
            sr.status,
            sr.started_at,
            sr.finished_at,
            LENGTH(COALESCE(sr.stdout, ''))
                AS stdout_chars,
            LENGTH(COALESCE(sr.stderr, ''))
                AS stderr_chars
        FROM scanner_runs sr
        JOIN (
            SELECT
                case_id,
                scanner,
                MAX(id) AS latest_id
            FROM scanner_runs
            WHERE case_id IS NOT NULL
            GROUP BY case_id, scanner
        ) latest
          ON latest.latest_id = sr.id
        ORDER BY sr.case_id, sr.scanner
        """
    )

    for row in latest_runs:
        add(
            int(row["case_id"]),
            "Scanner result",
            f"{row.get('scanner')} · {row.get('status')}",
            "scanner_runs",
            scanner=row.get("scanner"),
            status=row.get("status"),
            details=dict(row),
        )

    finding_rows = db.query(
        """
        SELECT
            case_id,
            scanner,
            finding_type,
            severity,
            rule_id,
            cwe,
            file_path,
            line,
            description,
            introduced
        FROM scanner_findings
        ORDER BY case_id, scanner, id
        """
    )

    for row in finding_rows:
        add(
            int(row["case_id"]),
            "Finding type",
            row.get("finding_type"),
            "scanner_findings.finding_type",
            path=row.get("file_path"),
            evidence=row.get("description"),
            scanner=row.get("scanner"),
            details=dict(row),
        )

        add(
            int(row["case_id"]),
            "Finding rule",
            row.get("rule_id"),
            "scanner_findings.rule_id",
            path=row.get("file_path"),
            evidence=row.get("description"),
            scanner=row.get("scanner"),
            details=dict(row),
        )

    return pd.DataFrame(records)


def _feature_summary(
    db: Database,
    records: pd.DataFrame,
) -> pd.DataFrame:
    if records.empty:
        return pd.DataFrame()

    summary = (
        records.groupby(
            ["family", "feature", "feature_key"],
            as_index=False,
        )
        .agg(
            cases=("case_id", "nunique"),
            repositories=("repo", "nunique"),
            supporting_rows=("case_id", "size"),
        )
    )

    introduced_cases = {
        int(row["case_id"])
        for row in db.query(
            """
            SELECT DISTINCT case_id
            FROM scanner_findings
            WHERE COALESCE(introduced, 0) = 1
              AND finding_type IN (
                  'vulnerability',
                  'dependency',
                  'secret'
              )
            """
        )
    }

    scanned_cases = {
        int(row["case_id"])
        for row in db.query(
            """
            SELECT DISTINCT case_id
            FROM scanner_runs
            WHERE case_id IS NOT NULL
            """
        )
    }

    introduced_counts: list[int] = []
    scanner_coverage: list[float] = []

    for row in summary.itertuples(index=False):
        case_ids = set(
            records.loc[
                records["feature_key"] == row.feature_key,
                "case_id",
            ].astype(int)
        )

        introduced_counts.append(
            len(case_ids & introduced_cases)
        )

        scanner_coverage.append(
            round(
                len(case_ids & scanned_cases)
                / len(case_ids)
                * 100,
                2,
            )
            if case_ids
            else 0.0
        )

    summary["introduced_cases"] = introduced_counts
    summary["scanner_coverage_pct"] = scanner_coverage

    return summary


def _chart_selection(event: Any) -> str | None:
    try:
        selected = event.selection.feature_pick
    except Exception:
        return None

    if not selected:
        return None

    try:
        return str(selected[0]["feature_key"])
    except Exception:
        return None


def _render_data_map(db: Database) -> None:
    records = _feature_rows(db)

    if records.empty:
        st.info("No feature data is currently stored.")
        return

    summary = _feature_summary(db, records)

    families = sorted(
        summary["family"].unique().tolist()
    )

    selected_families = st.multiselect(
        "Feature families",
        families,
        default=families,
        key="analytics_feature_families",
    )

    visible = summary[
        summary["family"].isin(selected_families)
    ].copy()

    if visible.empty:
        st.info("No features match the selected families.")
        return

    selection = alt.selection_point(
        name="feature_pick",
        fields=["feature_key"],
        on="click",
        clear="dblclick",
    )

    chart = (
        alt.Chart(visible)
        .mark_circle(opacity=0.8)
        .encode(
            x=alt.X(
                "cases:Q",
                title="Distinct cases",
            ),
            y=alt.Y(
                "repositories:Q",
                title="Distinct repositories",
            ),
            size=alt.Size(
                "supporting_rows:Q",
                title="Supporting database rows",
                scale=alt.Scale(range=[100, 2200]),
            ),
            color=alt.Color(
                "family:N",
                title="Feature family",
            ),
            opacity=alt.condition(
                selection,
                alt.value(1),
                alt.value(0.62),
            ),
            tooltip=[
                alt.Tooltip("family:N", title="Family"),
                alt.Tooltip("feature:N", title="Feature"),
                alt.Tooltip("cases:Q", title="Cases"),
                alt.Tooltip(
                    "repositories:Q",
                    title="Repositories",
                ),
                alt.Tooltip(
                    "supporting_rows:Q",
                    title="Supporting rows",
                ),
                alt.Tooltip(
                    "scanner_coverage_pct:Q",
                    title="Scanner coverage %",
                ),
                alt.Tooltip(
                    "introduced_cases:Q",
                    title="Introduced evidence cases",
                ),
            ],
        )
        .add_params(selection)
        .properties(
            height=430,
            title="Observed case features",
        )
        .interactive()
    )

    event = st.altair_chart(
        chart,
        use_container_width=True,
        on_select="rerun",
        selection_mode="feature_pick",
        key="analytics_feature_bubbles",
    )

    clicked = _chart_selection(event)

    options = sorted(
        visible["feature_key"].tolist()
    )

    if clicked in options:
        st.session_state[
            "analytics_selected_feature"
        ] = clicked

    current = st.session_state.get(
        "analytics_selected_feature"
    )

    if current not in options:
        current = options[0]

    selected_feature = st.selectbox(
        "Inspect feature",
        options,
        index=options.index(current),
        key="analytics_feature_select",
    )

    st.session_state[
        "analytics_selected_feature"
    ] = selected_feature

    supporting = records[
        records["feature_key"] == selected_feature
    ].copy()

    st.markdown(f"### `{selected_feature}`")

    c1, c2, c3 = st.columns(3)

    c1.metric(
        "Cases",
        int(supporting["case_id"].nunique()),
    )

    c2.metric(
        "Repositories",
        int(supporting["repo"].nunique()),
    )

    c3.metric(
        "Supporting rows",
        len(supporting),
    )

    st.dataframe(
        supporting[
            [
                "case_id",
                "repo",
                "source",
                "path",
                "evidence",
                "confidence",
                "scanner",
                "status",
                "issue_url",
                "pr_url",
                "details",
            ]
        ].sort_values(["case_id", "path"]),
        hide_index=True,
        use_container_width=True,
        column_config={
            "issue_url": st.column_config.LinkColumn(
                "Issue"
            ),
            "pr_url": st.column_config.LinkColumn(
                "PR"
            ),
        },
    )

    st.markdown("### Case × feature heatmap")

    limit = st.slider(
        "Maximum feature columns",
        10,
        min(80, len(summary)),
        min(35, len(summary)),
        key="analytics_heatmap_limit",
    )

    top_features = (
        summary.sort_values(
            ["cases", "supporting_rows"],
            ascending=False,
        )
        .head(limit)["feature_key"]
        .tolist()
    )

    heatmap_rows = records[
        records["feature_key"].isin(top_features)
    ].copy()

    heatmap_rows["case_label"] = (
        "#"
        + heatmap_rows["case_id"].astype(str)
        + " · "
        + heatmap_rows["repo"].astype(str)
    )

    heatmap_data = (
        heatmap_rows.groupby(
            ["case_label", "feature_key"],
            as_index=False,
        )
        .size()
        .rename(columns={"size": "support"})
    )

    heatmap = (
        alt.Chart(heatmap_data)
        .mark_rect()
        .encode(
            x=alt.X(
                "feature_key:N",
                title="Observed feature",
                sort=top_features,
                axis=alt.Axis(
                    labelAngle=-55,
                    labelLimit=180,
                ),
            ),
            y=alt.Y(
                "case_label:N",
                title="Case",
            ),
            color=alt.Color(
                "support:Q",
                title="Supporting rows",
            ),
            tooltip=[
                alt.Tooltip(
                    "case_label:N",
                    title="Case",
                ),
                alt.Tooltip(
                    "feature_key:N",
                    title="Feature",
                ),
                alt.Tooltip(
                    "support:Q",
                    title="Supporting rows",
                ),
            ],
        )
        .properties(
            height=max(
                320,
                heatmap_data["case_label"].nunique()
                * 18,
            )
        )
    )

    st.altair_chart(
        heatmap,
        use_container_width=True,
    )


def _latest_scanner_runs(db: Database) -> pd.DataFrame:
    return pd.DataFrame(
        db.query(
            """
            SELECT
                sr.case_id,
                r.full_name AS repo,
                sr.scanner,
                sr.status,
                sr.started_at,
                sr.finished_at,
                LENGTH(COALESCE(sr.stdout, ''))
                    AS stdout_chars,
                LENGTH(COALESCE(sr.stderr, ''))
                    AS stderr_chars
            FROM scanner_runs sr
            JOIN (
                SELECT
                    case_id,
                    scanner,
                    MAX(id) AS latest_id
                FROM scanner_runs
                WHERE case_id IS NOT NULL
                GROUP BY case_id, scanner
            ) latest
              ON latest.latest_id = sr.id
            JOIN cases c ON c.id = sr.case_id
            JOIN repos r ON r.id = c.repo_id
            ORDER BY sr.case_id, sr.scanner
            """
        )
    )


def _render_evidence(db: Database) -> None:
    runs = _latest_scanner_runs(db)

    if runs.empty:
        st.info("No scanner runs are currently stored.")
        return

    runs["case_label"] = (
        "#"
        + runs["case_id"].astype(str)
        + " · "
        + runs["repo"].astype(str)
    )

    chart = (
        alt.Chart(runs)
        .mark_rect()
        .encode(
            x=alt.X(
                "scanner:N",
                title="Scanner",
                axis=alt.Axis(labelAngle=-45),
            ),
            y=alt.Y(
                "case_label:N",
                title="Case",
            ),
            color=alt.Color(
                "status:N",
                title="Latest status",
            ),
            tooltip=[
                "case_label:N",
                "scanner:N",
                "status:N",
                "started_at:N",
                "finished_at:N",
                "stdout_chars:Q",
                "stderr_chars:Q",
            ],
        )
        .properties(
            height=max(
                360,
                runs["case_id"].nunique() * 18,
            ),
            title="Latest scanner result per case",
        )
    )

    st.altair_chart(
        chart,
        use_container_width=True,
    )

    st.markdown("### Introduced study-target evidence")

    findings = pd.DataFrame(
        db.query(
            """
            SELECT
                sf.case_id,
                r.full_name AS repo,
                sf.scanner,
                sf.finding_type,
                sf.severity,
                sf.rule_id,
                sf.cwe,
                sf.file_path,
                sf.line,
                sf.description,
                i.url AS issue_url,
                p.url AS pr_url
            FROM scanner_findings sf
            JOIN cases c ON c.id = sf.case_id
            JOIN repos r ON r.id = c.repo_id
            JOIN issues i ON i.id = c.issue_id
            JOIN pull_requests p ON p.id = c.pr_id
            WHERE COALESCE(sf.introduced, 0) = 1
              AND sf.finding_type IN (
                  'vulnerability',
                  'dependency',
                  'secret'
              )
            ORDER BY sf.case_id, sf.scanner
            """
        )
    )

    if findings.empty:
        st.warning(
            "No introduced vulnerability, dependency, "
            "or secret findings are currently stored."
        )
    else:
        st.dataframe(
            findings,
            hide_index=True,
            use_container_width=True,
            column_config={
                "issue_url": st.column_config.LinkColumn(
                    "Issue"
                ),
                "pr_url": st.column_config.LinkColumn(
                    "PR"
                ),
            },
        )

    st.markdown("### Raw scanner evidence")

    selected_case = st.selectbox(
        "Case",
        sorted(runs["case_id"].unique().tolist()),
        key="analytics_raw_case",
    )

    scanner_options = sorted(
        runs.loc[
            runs["case_id"] == selected_case,
            "scanner",
        ].unique().tolist()
    )

    selected_scanner = st.selectbox(
        "Scanner",
        scanner_options,
        key="analytics_raw_scanner",
    )

    raw = db.one(
        """
        SELECT
            scanner,
            status,
            started_at,
            finished_at,
            stdout,
            stderr
        FROM scanner_runs
        WHERE case_id=?
          AND scanner=?
        ORDER BY id DESC
        LIMIT 1
        """,
        (int(selected_case), selected_scanner),
    )

    if raw:
        st.write(
            {
                "scanner": raw.get("scanner"),
                "status": raw.get("status"),
                "started_at": raw.get("started_at"),
                "finished_at": raw.get("finished_at"),
                "stdout_chars": len(
                    raw.get("stdout") or ""
                ),
                "stderr_chars": len(
                    raw.get("stderr") or ""
                ),
            }
        )

        with st.expander(
            "stdout / structured evidence",
            expanded=False,
        ):
            stdout = raw.get("stdout") or ""

            try:
                st.json(json.loads(stdout))
            except Exception:
                st.code(stdout or "(empty)")

        with st.expander(
            "stderr",
            expanded=False,
        ):
            st.code(
                raw.get("stderr") or "(empty)"
            )


def _render_live_content(db: Database) -> None:
    st.caption(
        "This section refreshes from the active database "
        "every 10 seconds."
    )

    jobs = pd.DataFrame(
        db.query(
            """
            SELECT
                job_type,
                status,
                COUNT(*) AS jobs
            FROM scanner_jobs
            GROUP BY job_type, status
            ORDER BY job_type, status
            """
        )
    )

    if not jobs.empty:
        st.markdown("### Job state")

        pivot = (
            jobs.pivot(
                index="job_type",
                columns="status",
                values="jobs",
            )
            .fillna(0)
            .reset_index()
        )

        st.dataframe(
            pivot,
            hide_index=True,
            use_container_width=True,
        )

    active = db.query(
        """
        SELECT
            sj.case_id,
            r.full_name AS repo,
            sj.job_type,
            sj.status,
            sj.attempts,
            sj.worker_id,
            sj.route_reason,
            sj.started_at
        FROM scanner_jobs sj
        JOIN cases c ON c.id = sj.case_id
        JOIN repos r ON r.id = c.repo_id
        WHERE sj.status IN (
            'pending',
            'retry',
            'running'
        )
        ORDER BY sj.priority DESC, sj.created_at
        """
    )

    st.markdown("### Active work")

    if active:
        st.dataframe(
            pd.DataFrame(active),
            hide_index=True,
            use_container_width=True,
        )
    else:
        st.info("No active scanner jobs.")

    workers = db.query(
        """
        SELECT
            worker_id,
            worker_type,
            status,
            detail,
            updated_at
        FROM worker_heartbeats
        ORDER BY updated_at DESC
        """
    )

    st.markdown("### Workers")

    if workers:
        st.dataframe(
            pd.DataFrame(workers),
            hide_index=True,
            use_container_width=True,
        )
    else:
        st.info("No worker heartbeats recorded.")

    errors = db.query(
        """
        SELECT
            sj.case_id,
            r.full_name AS repo,
            sj.job_type,
            sj.status,
            sj.attempts,
            sj.last_error,
            sj.started_at,
            sj.finished_at
        FROM scanner_jobs sj
        JOIN cases c ON c.id = sj.case_id
        JOIN repos r ON r.id = c.repo_id
        WHERE sj.status IN (
            'error',
            'timeout',
            'retry'
        )
        ORDER BY COALESCE(
            sj.finished_at,
            sj.started_at,
            sj.created_at
        ) DESC
        LIMIT 100
        """
    )

    st.markdown("### Errors and retries")

    if errors:
        st.dataframe(
            pd.DataFrame(errors),
            hide_index=True,
            use_container_width=True,
        )
    else:
        st.success("No current errors or retries.")

    recent = db.query(
        """
        SELECT
            sr.case_id,
            r.full_name AS repo,
            sr.scanner,
            sr.status,
            sr.started_at,
            sr.finished_at,
            LENGTH(COALESCE(sr.stdout, ''))
                AS stdout_chars,
            LENGTH(COALESCE(sr.stderr, ''))
                AS stderr_chars
        FROM scanner_runs sr
        JOIN cases c ON c.id = sr.case_id
        JOIN repos r ON r.id = c.repo_id
        ORDER BY sr.id DESC
        LIMIT 150
        """
    )

    st.markdown("### Latest scanner activity")

    st.dataframe(
        pd.DataFrame(recent),
        hide_index=True,
        use_container_width=True,
    )


if hasattr(st, "fragment"):
    @st.fragment(run_every="10s")
    def _render_live_fragment(db_path: str) -> None:
        _render_live_content(
            Database(Path(db_path))
        )
else:
    def _render_live_fragment(db_path: str) -> None:
        _render_live_content(
            Database(Path(db_path))
        )


def render_analytics_tabs(settings) -> None:
    st.markdown("---")
    st.subheader("Live Mining Analytics")

    st.caption(
        "All values come from the active database. "
        "Selecting a feature reveals the exact file, "
        "classification evidence, route, case, issue "
        "and PR that produced it."
    )

    data_tab, evidence_tab, live_tab = st.tabs(
        [
            "Data Map",
            "Evidence",
            "Live Operations",
        ]
    )

    with data_tab:
        _render_data_map(
            Database(settings.db_path)
        )

    with evidence_tab:
        _render_evidence(
            Database(settings.db_path)
        )

    with live_tab:
        _render_live_fragment(
            str(settings.db_path)
        )
