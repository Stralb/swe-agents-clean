def _rows_to_frame(rows: list[dict[str, Any]]) -> pd.DataFrame:
    if not rows:
        return pd.DataFrame()

    frame = pd.DataFrame(rows)
    frame["case_id"] = pd.to_numeric(
        frame["case_id"],
        errors="coerce",
    ).fillna(0).astype(int)

    frame["feature_key"] = (
        frame["family"].astype(str)
        + " → "
        + frame["feature"].astype(str)
    )

    return frame


def _feature_data(
    db: Database,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    records = _rows_to_frame(
        db.query(FEATURE_QUERY)
    )

    if records.empty:
        return records, pd.DataFrame()

    introduced_rows = db.query(
        """
        SELECT DISTINCT case_id
        FROM scanner_findings
        WHERE COALESCE(introduced, 0) = 1
          AND finding_type IN (
              'vulnerability',
              'dependency',
              'secret'
          )
        """
    )

    introduced_cases = {
        int(row["case_id"])
        for row in introduced_rows
    }

    run_rows = db.query(
        """
        SELECT DISTINCT case_id
        FROM scanner_runs
        WHERE case_id IS NOT NULL
        """
    )

    scanned_cases = {
        int(row["case_id"])
        for row in run_rows
    }

    summary_rows: list[dict[str, Any]] = []

    for (family, feature), group in records.groupby(
        ["family", "feature"],
        dropna=False,
    ):
        case_ids = {
            int(value)
            for value in group["case_id"].tolist()
        }

        summary_rows.append(
            {
                "family": str(family),
                "feature": str(feature),
                "feature_key": (
                    str(family)
                    + " → "
                    + str(feature)
                ),
                "cases": len(case_ids),
                "repositories": int(
                    group["repo"].nunique()
                ),
                "supporting_records": len(group),
                "introduced_cases": len(
                    case_ids.intersection(
                        introduced_cases
                    )
                ),
                "scanner_coverage_pct": round(
                    (
                        len(
                            case_ids.intersection(
                                scanned_cases
                            )
                        )
                        / len(case_ids)
                        * 100
                    )
                    if case_ids
                    else 0.0,
                    2,
                ),
            }
        )

    summary = pd.DataFrame(summary_rows)

    return records, summary


def _event_feature_key(
    event: Any,
) -> str | None:
    if event is None:
        return None

    try:
        selection = event.selection
    except Exception:
        try:
            selection = event.get("selection", {})
        except Exception:
            return None

    if hasattr(selection, "to_dict"):
        try:
            selection = selection.to_dict()
        except Exception:
            pass

    if not isinstance(selection, dict):
        try:
            selection = dict(selection)
        except Exception:
            return None

    picked = selection.get("feature_pick")

    if isinstance(picked, list) and picked:
        first = picked[0]

        if isinstance(first, dict):
            return first.get("feature_key")

    if isinstance(picked, dict):
        if picked.get("feature_key"):
            return str(picked["feature_key"])

        values = picked.get("values")

        if isinstance(values, list) and values:
            first = values[0]

            if isinstance(first, dict):
                return first.get("feature_key")

    return None


