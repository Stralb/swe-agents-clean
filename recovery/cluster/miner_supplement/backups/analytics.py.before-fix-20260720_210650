def _latest_run_frame(
    db: Database,
) -> pd.DataFrame:
    rows = db.query(
        """
        SELECT
            sr.case_id,
            r.full_name AS repo,
            sr.scanner,
            sr.status,
            sr.started_at,
            sr.finished_at,
            LENGTH(COALESCE(sr.stdout, ''))
                AS stdout_chars,
            LENGTH(COALESCE(sr.stderr, ''))
                AS stderr_chars
        FROM scanner_runs sr
        JOIN (
            SELECT
                case_id,
                scanner,
                MAX(id) AS max_id
            FROM scanner_runs
            WHERE case_id IS NOT NULL
            GROUP BY case_id, scanner
        ) chosen
          ON chosen.max_id = sr.id
        JOIN cases c ON c.id = sr.case_id
        JOIN repos r ON r.id = c.repo_id
        ORDER BY sr.case_id, sr.scanner
        """
    )

    return pd.DataFrame(rows)


def _render_evidence(
    db: Database,
) -> None:
    latest = _latest_run_frame(db)

    if latest.empty:
        st.info("No scanner runs are available.")
        return

    st.subheader("Scanner execution matrix")

    latest["case_label"] = (
        "#"
        + latest["case_id"].astype(str)
        + " · "
        + latest["repo"].astype(str)
    )

    status_heatmap = (
        alt.Chart(latest)
        .mark_rect()
        .encode(
            x=alt.X(
                "scanner:N",
                title="Scanner",
                axis=alt.Axis(labelAngle=-45),
            ),
            y=alt.Y(
                "case_label:N",
                title="Case",
            ),
            color=alt.Color(
                "status:N",
                title="Latest status",
            ),
            tooltip=[
                "case_label:N",
                "scanner:N",
                "status:N",
                "started_at:N",
                "finished_at:N",
                "stdout_chars:Q",
                "stderr_chars:Q",
            ],
        )
        .properties(
            height=max(
                360,
                int(latest["case_id"].nunique())
                * 18,
            )
        )
    )

    st.altair_chart(
        status_heatmap,
        use_container_width=True,
    )

    summary = (
        latest.groupby(
            ["scanner", "status"]
        )["case_id"]
        .nunique()
        .reset_index(name="cases")
        .pivot(
            index="scanner",
            columns="status",
            values="cases",
        )
        .fillna(0)
        .reset_index()
    )

    st.dataframe(
        summary,
        hide_index=True,
        use_container_width=True,
    )

    findings = pd.DataFrame(
        db.query(
            """
            SELECT
                sf.case_id,
                r.full_name AS repo,
                sf.scanner,
                sf.finding_type,
                sf.severity,
                sf.rule_id,
                sf.cwe,
                sf.file_path,
                sf.line,
                sf.description,
                sf.introduced,
                i.url AS issue_url,
                p.url AS pr_url
            FROM scanner_findings sf
            JOIN cases c ON c.id = sf.case_id
            JOIN repos r ON r.id = c.repo_id
            JOIN issues i ON i.id = c.issue_id
            JOIN pull_requests p ON p.id = c.pr_id
            WHERE COALESCE(sf.introduced, 0) = 1
              AND sf.finding_type IN (
                  'vulnerability',
                  'dependency',
                  'secret'
              )
            ORDER BY sf.case_id, sf.scanner
            """
        )
    )

    st.subheader("Introduced study-target evidence")

    if findings.empty:
        st.warning(
            "No introduced vulnerability, dependency, "
            "or secret findings are currently stored."
        )
    else:
        matrix = (
            findings.groupby(
                ["case_id", "repo", "scanner"]
            )
            .size()
            .reset_index(name="findings")
        )

        matrix["case_label"] = (
            "#"
            + matrix["case_id"].astype(str)
            + " · "
            + matrix["repo"].astype(str)
        )

        finding_heatmap = (
            alt.Chart(matrix)
            .mark_rect()
            .encode(
                x=alt.X(
                    "scanner:N",
                    title="Scanner",
                ),
                y=alt.Y(
                    "case_label:N",
                    title="Case",
                ),
                color=alt.Color(
                    "findings:Q",
                    title="Introduced findings",
                ),
                tooltip=[
                    "case_label:N",
                    "scanner:N",
                    "findings:Q",
                ],
            )
        )

        st.altair_chart(
            finding_heatmap,
            use_container_width=True,
        )

        st.dataframe(
            findings,
            hide_index=True,
            use_container_width=True,
            column_config={
                "issue_url": (
                    st.column_config.LinkColumn(
                        "Issue"
                    )
                ),
                "pr_url": (
                    st.column_config.LinkColumn(
                        "PR"
                    )
                ),
            },
        )

    st.subheader("Raw evidence verification")

    case_options = sorted(
        latest["case_id"].unique().tolist()
    )

    selected_case = st.selectbox(
        "Case",
        options=case_options,
        key="analytics_evidence_case",
    )

    scanner_options = sorted(
        latest[
            latest["case_id"] == selected_case
        ]["scanner"].unique().tolist()
    )

    selected_scanner = st.selectbox(
        "Scanner",
        options=scanner_options,
        key="analytics_evidence_scanner",
    )

    raw = db.one(
        """
        SELECT
            scanner,
            status,
            started_at,
            finished_at,
            stdout,
            stderr
        FROM scanner_runs
        WHERE case_id=?
          AND scanner=?
        ORDER BY id DESC
        LIMIT 1
        """,
        (
            int(selected_case),
            selected_scanner,
        ),
    )

    if raw:
        c1, c2, c3 = st.columns(3)

        c1.metric(
            "Status",
            raw.get("status") or "",
        )

        c2.metric(
            "stdout characters",
            len(raw.get("stdout") or ""),
        )

        c3.metric(
            "stderr characters",
            len(raw.get("stderr") or ""),
        )

        with st.expander(
            "stdout / stored structured evidence",
            expanded=False,
        ):
            stdout = raw.get("stdout") or ""

            try:
                st.json(json.loads(stdout))
            except Exception:
                st.code(stdout or "(empty)")

        with st.expander(
            "stderr",
            expanded=False,
        ):
            st.code(
                raw.get("stderr") or "(empty)"
            )

    if st.button(
        "Open selected case in Case Review",
        key="analytics_open_evidence_case",
    ):
        _open_case(int(selected_case))


def _parse_time(
    value: Any,
) -> datetime | None:
    if not value:
        return None

    text = str(value).replace("Z", "+00:00")

    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None

    if parsed.tzinfo is None:
        parsed = parsed.replace(
            tzinfo=timezone.utc
        )

    return parsed.astimezone(timezone.utc)


def _render_live_operations_content(
    db: Database,
) -> None:
    st.caption(
        "Live data refreshes every 10 seconds."
    )

    job_rows = pd.DataFrame(
        db.query(
            """
            SELECT
                job_type,
                status,
                COUNT(*) AS jobs
            FROM scanner_jobs
            GROUP BY job_type, status
            ORDER BY job_type, status
            """
        )
    )

    if not job_rows.empty:
        job_pivot = (
            job_rows.pivot(
                index="job_type",
                columns="status",
                values="jobs",
            )
            .fillna(0)
            .reset_index()
        )

        st.subheader("Job state")

        st.dataframe(
            job_pivot,
            hide_index=True,
            use_container_width=True,
        )

    running = pd.DataFrame(
        db.query(
            """
            SELECT
                sj.id,
                sj.case_id,
                r.full_name AS repo,
                sj.job_type,
                sj.status,
                sj.attempts,
                sj.worker_id,
                sj.route_reason,
                sj.started_at
            FROM scanner_jobs sj
            JOIN cases c ON c.id = sj.case_id
            JOIN repos r ON r.id = c.repo_id
            WHERE sj.status IN (
                'pending',
                'retry',
                'running'
            )
            ORDER BY
                CASE sj.status
                    WHEN 'running' THEN 0
                    WHEN 'retry' THEN 1
                    ELSE 2
                END,
                sj.priority DESC,
                sj.created_at
            """
        )
    )

    st.subheader("Active work")

    if running.empty:
        st.info(
            "No pending, retrying or running jobs."
        )
    else:
        st.dataframe(
            running,
            hide_index=True,
            use_container_width=True,
        )

    heartbeat_rows = db.query(
        """
        SELECT
            worker_id,
            worker_type,
            mode,
            status,
            detail,
            updated_at
        FROM worker_heartbeats
        ORDER BY updated_at DESC
        """
    )

    now = datetime.now(timezone.utc)

    for row in heartbeat_rows:
        parsed = _parse_time(row.get("updated_at"))

        row["age_seconds"] = (
            round(
                (now - parsed).total_seconds(),
                1,
            )
            if parsed
            else None
        )

    st.subheader("Workers")

    if heartbeat_rows:
        st.dataframe(
            pd.DataFrame(heartbeat_rows),
            hide_index=True,
            use_container_width=True,
        )
    else:
        st.info("No worker heartbeats recorded.")

    errors = pd.DataFrame(
        db.query(
            """
            SELECT
                sj.case_id,
                r.full_name AS repo,
                sj.job_type,
                sj.status,
                sj.attempts,
                sj.last_error,
                sj.started_at,
                sj.finished_at
            FROM scanner_jobs sj
            JOIN cases c ON c.id = sj.case_id
            JOIN repos r ON r.id = c.repo_id
            WHERE sj.status IN (
                'error',
                'timeout',
                'retry'
            )
               OR COALESCE(
                    sj.last_error,
                    ''
                  ) NOT IN (
                    '',
                    'ok'
                  )
            ORDER BY
                COALESCE(
                    sj.finished_at,
                    sj.started_at,
                    sj.created_at
                ) DESC
            LIMIT 100
            """
        )
    )

    st.subheader("Recent errors and retries")

    if errors.empty:
        st.success(
            "No current job errors or retries."
        )
    else:
        st.dataframe(
            errors,
            hide_index=True,
            use_container_width=True,
        )

    recent_runs = pd.DataFrame(
        db.query(
            """
            SELECT
                sr.case_id,
                r.full_name AS repo,
                sr.scanner,
                sr.status,
                sr.started_at,
                sr.finished_at,
                LENGTH(COALESCE(sr.stdout, ''))
                    AS stdout_chars,
                LENGTH(COALESCE(sr.stderr, ''))
                    AS stderr_chars
            FROM scanner_runs sr
            JOIN cases c ON c.id = sr.case_id
            JOIN repos r ON r.id = c.repo_id
            ORDER BY sr.id DESC
            LIMIT 150
            """
        )
    )

    st.subheader("Latest scanner activity")

    st.dataframe(
        recent_runs,
        hide_index=True,
        use_container_width=True,
    )

    throughput = pd.DataFrame(
        db.query(
            """
            SELECT
                substr(finished_at, 1, 16)
                    AS minute,
                scanner,
                COUNT(*) AS completed
            FROM scanner_runs
            WHERE finished_at IS NOT NULL
            GROUP BY
                substr(finished_at, 1, 16),
                scanner
            ORDER BY minute
            """
        )
    )

    if not throughput.empty:
        activity_chart = (
            alt.Chart(throughput)
            .mark_line(point=True)
            .encode(
                x=alt.X(
                    "minute:N",
                    title="Finish minute",
                    axis=alt.Axis(
                        labelAngle=-45,
                        labelLimit=100,
                    ),
                ),
                y=alt.Y(
                    "completed:Q",
                    title="Completed runs",
                ),
                color=alt.Color(
                    "scanner:N",
                    title="Scanner",
                ),
                tooltip=[
                    "minute:N",
                    "scanner:N",
                    "completed:Q",
                ],
            )
            .properties(
                height=320,
                title="Scanner completion activity",
            )
        )

        st.altair_chart(
            activity_chart,
            use_container_width=True,
        )


if hasattr(st, "fragment"):
    @st.fragment(run_every="10s")
    def _render_live_operations(
        db_path: str,
    ) -> None:
        _render_live_operations_content(
            Database(db_path)
        )
else:
    def _render_live_operations(
        db_path: str,
    ) -> None:
        _render_live_operations_content(
            Database(db_path)
        )


