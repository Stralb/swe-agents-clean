from __future__ import annotations

import html
import re
from typing import Iterable, Mapping, Sequence

import streamlit as st

SIGNAL_COLORS = {
    "dependency": "#ea580c",
    "secret": "#dc2626",
    "ci": "#dc2626",
    "sast": "#16a34a",
    "source-code": "#16a34a",
    "source": "#16a34a",
    "vulnerability": "#0f766e",
    "codeql": "#0f766e",
}


def safe_markdown(text: str | None, *, max_chars: int = 30000) -> None:
    """Render user-provided GitHub markdown in a readable container.

    Streamlit sanitizes markdown HTML by default when unsafe_allow_html=False.
    We cap very long content to keep review pages responsive.
    """
    body = (text or "").strip()
    if not body:
        st.info("No body text stored.")
        return
    truncated = len(body) > max_chars
    body = body[:max_chars]
    st.markdown(body)
    if truncated:
        st.caption(f"Showing first {max_chars:,} characters to keep the UI responsive. Export the case for full evidence.")


def _finding_color(finding: Mapping) -> str:
    blob = " ".join(str(finding.get(k) or "") for k in ("finding_type", "scanner", "rule_id", "description")).lower()
    for key, color in SIGNAL_COLORS.items():
        if key in blob:
            return color
    return "#f59e0b"


def _line_matches(file_path: str, line_no: int | None, finding: Mapping) -> bool:
    if line_no is None:
        return False
    fpath = str(finding.get("file_path") or "")
    if fpath and fpath != file_path and not fpath.endswith(file_path) and not file_path.endswith(fpath):
        return False
    try:
        start = int(finding.get("line") or finding.get("start_line") or 0)
    except Exception:
        start = 0
    try:
        end = int(finding.get("end_line") or start)
    except Exception:
        end = start
    return bool(start and start <= line_no <= max(start, end))


def _hunk_new_start(line: str) -> int | None:
    match = re.search(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", line)
    if not match:
        return None
    return int(match.group(1))


def render_diff(
    patch: str | None,
    *,
    max_lines: int | None = 420,
    file_path: str = "",
    findings: Sequence[Mapping] | None = None,
) -> None:
    """Render a unified diff with every matching scanner finding."""

    if not patch:
        st.info(
            "No patch stored for this file."
        )
        return

    findings = list(findings or [])
    patch_lines = patch.splitlines()

    if max_lines is None:
        lines = patch_lines
        truncated = False
    else:
        safe_limit = max(
            1,
            int(max_lines),
        )

        lines = patch_lines[:safe_limit]

        truncated = (
            len(patch_lines)
            > safe_limit
        )

    def hunk_starts(
        line: str,
    ) -> tuple[int | None, int | None]:
        try:
            header = line.split(
                "@@",
                2,
            )[1].strip()

            parts = header.split()

            old_start = int(
                parts[0][1:]
                .split(",", 1)[0]
            )

            new_start = int(
                parts[1][1:]
                .split(",", 1)[0]
            )

            return old_start, new_start

        except Exception:
            return None, None

    def finding_matches_line(
        finding: Mapping,
        line_number: int | None,
    ) -> bool:
        if line_number is None:
            return False

        if not _line_matches(
            file_path,
            line_number,
            finding,
        ):
            start = finding.get(
                "start_line"
            )

            if start in (None, ""):
                start = finding.get("line")

            end = finding.get(
                "end_line"
            )

            try:
                start_value = int(
                    start or 0
                )
            except (TypeError, ValueError):
                start_value = 0

            try:
                end_value = int(
                    end or start_value
                )
            except (TypeError, ValueError):
                end_value = start_value

            if start_value <= 0:
                return False

            finding_path = str(
                finding.get("file_path")
                or ""
            ).replace("\\", "/")

            rendered_path = str(
                file_path
                or ""
            ).replace("\\", "/")

            path_match = (
                not finding_path
                or finding_path == rendered_path
                or finding_path.endswith(
                    "/" + rendered_path
                )
                or rendered_path.endswith(
                    "/" + finding_path
                )
            )

            return (
                path_match
                and start_value
                <= line_number
                <= max(
                    start_value,
                    end_value,
                )
            )

        return True

    def finding_badge(
        finding: Mapping,
    ) -> str:
        scanner = str(
            finding.get("scanner_label")
            or finding.get("scanner")
            or "Scanner"
        )

        severity = str(
            finding.get("severity")
            or "Unranked"
        )

        identifier = str(
            finding.get("identifier")
            or finding.get("rule_id")
            or finding.get("finding_type")
            or "finding"
        )

        description = str(
            finding.get("description")
            or ""
        )

        finding_id = finding.get(
            "finding_id"
        )

        location = str(
            finding.get("location_label")
            or ""
        )

        tooltip = " | ".join(
            value
            for value in (
                scanner,
                severity,
                identifier,
                location,
                description,
            )
            if value
        )

        badge_text = ""

        if finding_id not in (
            None,
            "",
        ):
            badge_text += (
                "#" + str(finding_id) + " "
            )

        badge_text += (
            scanner
            + " - "
            + severity
            + " - "
            + identifier
        )

        color = _finding_color(
            finding
        )

        return (
            '<span class="diff-finding" '
            f'title="{html.escape(tooltip, quote=True)}" '
            'style="'
            f'border-color:{color}; '
            f'color:{color}; '
            'cursor:help;'
            '">'
            f'{html.escape(badge_text)}'
            '</span>'
        )

    html_lines: list[str] = []

    old_line: int | None = None
    new_line: int | None = None

    matched_finding_ids = set()

    for line in lines:
        cls = "ctx"
        line_no_for_match: int | None = None

        old_display = ""
        new_display = ""

        if (
            line.startswith("+++")
            or line.startswith("---")
            or line.startswith("diff --git")
        ):
            cls = "file"

        elif line.startswith("@@"):
            cls = "hunk"

            old_line, new_line = (
                hunk_starts(line)
            )

        elif line.startswith("+"):
            cls = "add"
            line_no_for_match = new_line

            if new_line is not None:
                new_display = str(new_line)
                new_line += 1

        elif line.startswith("-"):
            cls = "del"

            if old_line is not None:
                old_display = str(old_line)
                old_line += 1

        elif line.startswith("\\"):
            cls = "ctx"

        else:
            line_no_for_match = new_line

            if old_line is not None:
                old_display = str(old_line)
                old_line += 1

            if new_line is not None:
                new_display = str(new_line)
                new_line += 1

        matched = [
            finding
            for finding in findings
            if finding_matches_line(
                finding,
                line_no_for_match,
            )
        ]

        style = ""
        annotation = ""

        if matched:
            color = _finding_color(
                matched[0]
            )

            style = (
                " border-left:4px solid "
                f"{color}; "
                f"background:{color}24;"
            )

            labels = []

            for finding in matched:
                labels.append(
                    finding_badge(finding)
                )

                identity = (
                    finding.get("finding_id")
                    or (
                        finding.get("scanner"),
                        finding.get("rule_id"),
                        finding.get("line"),
                        finding.get("description"),
                    )
                )

                matched_finding_ids.add(
                    str(identity)
                )

            annotation = (
                " "
                + " ".join(labels)
            )

        prefix = (
            html.escape(line[:1])
            if line
            else ""
        )

        body = html.escape(
            line[1:]
            if line
            else ""
        )

        gutter = (
            '<span style="'
            'display:inline-block;'
            'width:7.5rem;'
            'padding-right:.75rem;'
            'text-align:right;'
            'color:#64748b;'
            'user-select:none;'
            '">'
            f'{html.escape(old_display):>5} '
            f'{html.escape(new_display):>5}'
            '</span>'
        )

        html_lines.append(
            f'<div class="diff-line diff-{cls}" '
            f'style="{style}">'
            + gutter
            + (
                '<span class="diff-prefix">'
                + prefix
                + '</span>'
            )
            + body
            + annotation
            + '</div>'
        )

    if truncated:
        html_lines.append(
            '<div class="diff-line diff-hunk">'
            f'... truncated after {len(lines)} lines.'
            '</div>'
        )

    st.markdown(
        '<div class="diff-box">'
        + "".join(html_lines)
        + '</div>',
        unsafe_allow_html=True,
    )

    exact_findings = [
        finding
        for finding in findings
        if int(
            finding.get("start_line")
            or finding.get("line")
            or 0
        ) > 0
    ]

    unmatched_exact = []

    for finding in exact_findings:
        identity = (
            finding.get("finding_id")
            or (
                finding.get("scanner"),
                finding.get("rule_id"),
                finding.get("line"),
                finding.get("description"),
            )
        )

        if str(identity) not in matched_finding_ids:
            unmatched_exact.append(finding)

    if unmatched_exact:
        st.caption(
            f"{len(unmatched_exact)} exact finding(s) "
            "for this file are outside the rendered "
            "patch lines and remain in the finding "
            "table above."
        )


def compact_tags(tags: Iterable[str]) -> str:
    clean = [str(t) for t in tags if str(t).strip()]
    return ", ".join(clean) if clean else "None"
