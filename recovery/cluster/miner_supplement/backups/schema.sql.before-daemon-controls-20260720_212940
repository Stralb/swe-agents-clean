PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS repos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name TEXT UNIQUE NOT NULL,
    html_url TEXT NOT NULL,
    stars INTEGER DEFAULT 0,
    language TEXT,
    archived INTEGER DEFAULT 0,
    collected_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS issues (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repo_id INTEGER NOT NULL,
    github_id INTEGER,
    number INTEGER NOT NULL,
    url TEXT NOT NULL,
    title TEXT,
    body TEXT,
    author TEXT,
    state TEXT,
    labels TEXT,
    comments_count INTEGER DEFAULT 0,
    created_at TEXT,
    updated_at TEXT,
    closed_at TEXT,
    word_count INTEGER DEFAULT 0,
    is_english INTEGER DEFAULT 1,
    UNIQUE(repo_id, number),
    FOREIGN KEY(repo_id) REFERENCES repos(id)
);

CREATE TABLE IF NOT EXISTS pull_requests (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repo_id INTEGER NOT NULL,
    number INTEGER NOT NULL,
    url TEXT NOT NULL,
    title TEXT,
    body TEXT,
    author TEXT,
    state TEXT,
    merged INTEGER DEFAULT 0,
    head_ref TEXT,
    base_ref TEXT,
    head_sha TEXT,
    base_sha TEXT,
    additions INTEGER DEFAULT 0,
    deletions INTEGER DEFAULT 0,
    changed_files_count INTEGER DEFAULT 0,
    commits_count INTEGER DEFAULT 0,
    review_comments_count INTEGER DEFAULT 0,
    created_at TEXT,
    updated_at TEXT,
    closed_at TEXT,
    merged_at TEXT,
    UNIQUE(repo_id, number),
    FOREIGN KEY(repo_id) REFERENCES repos(id)
);

CREATE TABLE IF NOT EXISTS pr_files (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pr_id INTEGER NOT NULL,
    filename TEXT NOT NULL,
    status TEXT,
    additions INTEGER DEFAULT 0,
    deletions INTEGER DEFAULT 0,
    patch TEXT,
    category TEXT,
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);

CREATE TABLE IF NOT EXISTS issue_pr_links (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    issue_id INTEGER NOT NULL,
    pr_id INTEGER NOT NULL,
    method TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(issue_id, pr_id),
    FOREIGN KEY(issue_id) REFERENCES issues(id),
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);

CREATE TABLE IF NOT EXISTS upstream_features (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    issue_id INTEGER UNIQUE NOT NULL,
    has_code_block INTEGER DEFAULT 0,
    has_inline_code INTEGER DEFAULT 0,
    has_traceback_or_log INTEGER DEFAULT 0,
    has_file_path INTEGER DEFAULT 0,
    has_function_or_class INTEGER DEFAULT 0,
    has_dependency_or_version INTEGER DEFAULT 0,
    has_suggested_fix INTEGER DEFAULT 0,
    has_ai_marker INTEGER DEFAULT 0,
    feature_json TEXT,
    FOREIGN KEY(issue_id) REFERENCES issues(id)
);

CREATE TABLE IF NOT EXISTS ai_markers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER,
    issue_id INTEGER,
    pr_id INTEGER,
    marker_text TEXT NOT NULL,
    marker_location TEXT NOT NULL,
    confidence TEXT NOT NULL,
    matched_tool TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS scanner_runs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER,
    pr_id INTEGER NOT NULL,
    scanner TEXT NOT NULL,
    status TEXT NOT NULL,
    started_at TEXT DEFAULT CURRENT_TIMESTAMP,
    finished_at TEXT,
    stdout TEXT,
    stderr TEXT,
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);

CREATE TABLE IF NOT EXISTS scanner_findings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER,
    pr_id INTEGER NOT NULL,
    scanner TEXT NOT NULL,
    finding_type TEXT NOT NULL,
    severity TEXT,
    rule_id TEXT,
    cwe TEXT,
    file_path TEXT,
    line INTEGER,
    description TEXT,
    evidence TEXT,
    raw_json TEXT,
    introduced INTEGER DEFAULT 1,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);

CREATE TABLE IF NOT EXISTS cases (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repo_id INTEGER NOT NULL,
    issue_id INTEGER NOT NULL,
    pr_id INTEGER NOT NULL,
    ai_cohort TEXT DEFAULT 'AI-unknown',
    downstream_signal TEXT,
    auto_tags TEXT,
    status TEXT DEFAULT 'queued',
    final_label TEXT DEFAULT 'Unclear',
    review_notes TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(issue_id, pr_id),
    FOREIGN KEY(repo_id) REFERENCES repos(id),
    FOREIGN KEY(issue_id) REFERENCES issues(id),
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);

CREATE TABLE IF NOT EXISTS tags (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL,
    type TEXT DEFAULT 'manual',
    color TEXT,
    description TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS case_tags (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER NOT NULL,
    tag_id INTEGER NOT NULL,
    added_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(case_id, tag_id),
    FOREIGN KEY(case_id) REFERENCES cases(id),
    FOREIGN KEY(tag_id) REFERENCES tags(id)
);

CREATE TABLE IF NOT EXISTS case_notes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER NOT NULL,
    note TEXT NOT NULL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(case_id) REFERENCES cases(id)
);


CREATE TABLE IF NOT EXISTS excluded_cases (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repo TEXT,
    issue_number INTEGER,
    pr_number INTEGER,
    reason TEXT NOT NULL,
    details TEXT,
    changed_files_json TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_excluded_cases_reason ON excluded_cases(reason);

CREATE INDEX IF NOT EXISTS idx_cases_status ON cases(status);
CREATE INDEX IF NOT EXISTS idx_findings_case ON scanner_findings(case_id);
CREATE INDEX IF NOT EXISTS idx_pr_files_pr ON pr_files(pr_id);

-- Continuous worker pipeline tables -------------------------------------------------
CREATE TABLE IF NOT EXISTS scanner_jobs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER NOT NULL,
    job_type TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending',
    priority INTEGER DEFAULT 0,
    attempts INTEGER DEFAULT 0,
    last_error TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    started_at TEXT,
    finished_at TEXT,
    worker_id TEXT,
    route_reason TEXT,
    UNIQUE(case_id, job_type),
    FOREIGN KEY(case_id) REFERENCES cases(id)
);

CREATE INDEX IF NOT EXISTS idx_scanner_jobs_status ON scanner_jobs(status, priority, created_at);
CREATE INDEX IF NOT EXISTS idx_scanner_jobs_case ON scanner_jobs(case_id);

CREATE TABLE IF NOT EXISTS worker_heartbeats (
    worker_id TEXT PRIMARY KEY,
    worker_type TEXT NOT NULL,
    mode TEXT,
    status TEXT NOT NULL,
    detail TEXT,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS github_rate_limits (
    resource TEXT PRIMARY KEY,
    limit_value INTEGER,
    remaining INTEGER,
    reset_at INTEGER,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    last_sleep_until INTEGER,
    last_message TEXT
);

CREATE TABLE IF NOT EXISTS pipeline_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_type TEXT NOT NULL,
    detail TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS retrieval_queries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    stream_key TEXT NOT NULL,
    term TEXT NOT NULL,
    final_query TEXT NOT NULL UNIQUE,
    raw_count INTEGER DEFAULT 0,
    unique_count INTEGER DEFAULT 0,
    eligible_count INTEGER DEFAULT 0,
    candidate_count INTEGER DEFAULT 0,
    duplicate_count INTEGER DEFAULT 0,
    repo_filter_count INTEGER DEFAULT 0,
    processed_count INTEGER DEFAULT 0,
    excluded_count INTEGER DEFAULT 0,
    search_window_count INTEGER DEFAULT 0,
    split_window_count INTEGER DEFAULT 0,
    probe_count INTEGER DEFAULT 0,
    reported_total_count INTEGER DEFAULT 0,
    next_page INTEGER DEFAULT 1,
    exhausted INTEGER DEFAULT 0,
    last_error TEXT,
    status TEXT DEFAULT 'pending',
    last_run_at TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS case_retrievals (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER NOT NULL,
    stream_key TEXT NOT NULL,
    term TEXT NOT NULL,
    final_query TEXT NOT NULL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(case_id, stream_key, term),
    FOREIGN KEY(case_id) REFERENCES cases(id)
);

CREATE INDEX IF NOT EXISTS idx_case_retrievals_case ON case_retrievals(case_id);
CREATE INDEX IF NOT EXISTS idx_case_retrievals_term ON case_retrievals(term);

-- Artifact-region methodology tables -------------------------------------------
CREATE TABLE IF NOT EXISTS artifact_regions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    case_id INTEGER NOT NULL,
    pr_id INTEGER NOT NULL,
    pr_file_id INTEGER,
    path TEXT NOT NULL,
    region TEXT NOT NULL,
    language TEXT,
    generated INTEGER DEFAULT 0,
    vendor INTEGER DEFAULT 0,
    scanner_routes TEXT,
    confidence TEXT,
    evidence TEXT,
    mapping_version TEXT NOT NULL DEFAULT '1.0',
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(case_id) REFERENCES cases(id),
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id),
    FOREIGN KEY(pr_file_id) REFERENCES pr_files(id)
);
CREATE INDEX IF NOT EXISTS idx_artifact_regions_case ON artifact_regions(case_id);
CREATE INDEX IF NOT EXISTS idx_artifact_regions_region ON artifact_regions(region);

CREATE TABLE IF NOT EXISTS pr_region_profiles (
    case_id INTEGER PRIMARY KEY,
    pr_id INTEGER NOT NULL,
    primary_region TEXT NOT NULL,
    region_counts_json TEXT NOT NULL,
    scanner_routes_json TEXT NOT NULL,
    language_json TEXT,
    file_count INTEGER DEFAULT 0,
    mapping_version TEXT NOT NULL DEFAULT '1.0',
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(case_id) REFERENCES cases(id),
    FOREIGN KEY(pr_id) REFERENCES pull_requests(id)
);
CREATE INDEX IF NOT EXISTS idx_pr_region_profiles_region ON pr_region_profiles(primary_region);

CREATE TABLE IF NOT EXISTS repo_eligibility (
    repo_full_name TEXT PRIMARY KEY,
    stars INTEGER DEFAULT 0,
    archived INTEGER DEFAULT 0,
    fork INTEGER DEFAULT 0,
    has_issues INTEGER DEFAULT 1,
    primary_language TEXT,
    language_bytes_json TEXT,
    total_language_bytes INTEGER DEFAULT 0,
    javascript_bytes INTEGER DEFAULT 0,
    typescript_bytes INTEGER DEFAULT 0,
    js_ts_bytes INTEGER DEFAULT 0,
    js_ts_share REAL DEFAULT 0.0,
    min_stars INTEGER DEFAULT 0,
    min_js_ts_share REAL DEFAULT 0.0,
    eligible INTEGER DEFAULT 0,
    reason TEXT,
    checked_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_repo_eligibility_eligible
ON repo_eligibility(
    eligible,
    js_ts_share
);

