def _state_sets(
    db: Database,
    scanner: str,
    finding_cases: set[int],
) -> dict[str, set[int]]:
    job_types = SCANNER_JOB_TYPES[
        scanner
    ]

    placeholders = ",".join(
        "?"
        for _ in job_types
    )

    jobs = db.query(
        f"""
        SELECT
            id,
            case_id,
            job_type,
            status,
            last_error

        FROM scanner_jobs

        WHERE job_type IN (
            {placeholders}
        )

        ORDER BY
            case_id,

            CASE
                WHEN job_type='codeql_security'
                THEN 0
                ELSE 1
            END,

            id DESC
        """,
        tuple(job_types),
    )

    latest_jobs: dict[
        int,
        dict[str, Any],
    ] = {}

    for row in jobs:
        case_id = _integer(
            row.get("case_id")
        )

        if case_id:
            latest_jobs.setdefault(
                case_id,
                row,
            )

    runs = db.query(
        """
        SELECT
            id,
            case_id,
            scanner,
            status,
            stderr

        FROM scanner_runs

        ORDER BY id DESC
        """
    )

    latest_runs: dict[
        int,
        dict[str, Any],
    ] = {}

    for row in runs:
        if (
            _canonical_scanner(
                row.get("scanner")
            )
            != scanner
        ):
            continue

        case_id = _integer(
            row.get("case_id")
        )

        if case_id:
            latest_runs.setdefault(
                case_id,
                row,
            )

    applicable: set[int] = set()
    active: set[int] = set()
    errors: set[int] = set()

    all_cases = (
        set(latest_jobs)
        | set(latest_runs)
        | set(finding_cases)
    )

    for case_id in all_cases:
        job = latest_jobs.get(
            case_id,
            {},
        )

        run = latest_runs.get(
            case_id,
            {},
        )

        job_status = str(
            job.get("status")
            or ""
        ).strip().lower()

        run_status = str(
            run.get("status")
            or ""
        ).strip().lower()

        if (
            job_status
            in NOT_APPLICABLE
            and case_id
            not in latest_runs
            and case_id
            not in finding_cases
        ):
            continue

        applicable.add(case_id)

        effective_status = (
            job_status
            or run_status
        )

        if effective_status in ACTIVE_STATUSES:
            active.add(case_id)

        if (
            _is_error(job_status)
            or _is_error(run_status)
            or _is_error(
                job.get("last_error")
            )
            or _is_error(
                run.get("stderr")
            )
        ):
            errors.add(case_id)

    return {
        "applicable": applicable,
        "active": active,
        "errors": errors,
        "findings": finding_cases,
        "findings_errors": (
            finding_cases
            | errors
        ),
    }


def _event_value(
    event: Any,
    selection_name: str,
) -> str | None:
    if event is None:
        return None

    selection = None

    try:
        selection = event.get(
            "selection",
            {}
        ).get(selection_name)
    except Exception:
        pass

    if selection is None:
        try:
            selection = getattr(
                event.selection,
                selection_name,
            )
        except Exception:
            pass

    if isinstance(
        selection,
        list,
    ) and selection:
        item = selection[0]

        if isinstance(
            item,
            dict,
        ):
            value = item.get("name")

            return (
                str(value)
                if value
                else None
            )

    if isinstance(
        selection,
        dict,
    ):
        value = selection.get("name")

        if isinstance(value, list):
            return (
                str(value[0])
                if value
                else None
            )

        return (
            str(value)
            if value
            else None
        )

    return None


def _safe_key(
    value: str,
) -> str:
    return "".join(
        character
        if character.isalnum()
        else "_"
        for character in value
    )


def _interactive_chart(
    *,
    rows: list[dict[str, Any]],
    case_map: dict[str, list[int]],
    scanner: str,
    dimension: str,
) -> None:
    if not rows:
        st.info(
            "No stored values for this view."
        )
        return

    frame = pd.DataFrame(
        rows[:25]
    )

    selection_name = (
        "scanner_pick_"
        + _safe_key(
            scanner
            + "_"
            + dimension
        )
    )

    selection = alt.selection_point(
        name=selection_name,
        fields=["name"],
        on="click",
        clear="dblclick",
        empty=False,
    )

    chart = (
        alt.Chart(frame)
        .mark_bar(
            cornerRadiusEnd=6,
        )
        .encode(
            y=alt.Y(
                "name:N",
                sort="-x",
                title=None,
            ),
            x=alt.X(
                "findings:Q",
                title="Findings",
            ),
            color=alt.condition(
                selection,
                alt.value("#2563eb"),
                alt.value("#93c5fd"),
            ),
            tooltip=[
                alt.Tooltip(
                    "name:N",
                    title=dimension,
                ),
                alt.Tooltip(
                    "findings:Q",
                    title="Findings",
                    format=",",
                ),
                alt.Tooltip(
                    "cases:Q",
                    title="Cases",
                    format=",",
                ),
                alt.Tooltip(
                    "introduced:Q",
                    title="Introduced",
                    format=",",
                ),
                alt.Tooltip(
                    "identifiers:N",
                    title="Identifiers",
                ),
                alt.Tooltip(
                    "packages:N",
                    title="Packages",
                ),
                alt.Tooltip(
                    "versions:N",
                    title="Versions",
                ),
                alt.Tooltip(
                    "files:N",
                    title="Files",
                ),
                alt.Tooltip(
                    "details:N",
                    title="Details",
                ),
            ],
        )
        .add_params(selection)
        .properties(
            height=min(
                500,
                max(
                    220,
                    len(frame) * 30,
                ),
            )
        )
    )

    nonce = _integer(
        st.session_state.get(
            "scanner_chart_nonce"
        )
    )

    event = None

    try:
        event = st.altair_chart(
            chart,
            width="stretch",
            key=(
                "scanner-chart-"
                + scanner
                + "-"
                + _safe_key(dimension)
                + "-"
                + str(nonce)
            ),
            on_select="rerun",
            selection_mode=(
                selection_name
            ),
        )
    except TypeError:
        st.altair_chart(
            chart,
            width="stretch",
            key=(
                "scanner-chart-fallback-"
                + scanner
                + "-"
                + _safe_key(dimension)
            ),
        )

    value = _event_value(
        event,
        selection_name,
    )

    if value:
        st.session_state[
            "scanner_chart_filter"
        ] = {
            "scanner": scanner,
            "dimension": dimension,
            "value": value,
            "case_ids": case_map.get(
                value,
                [],
            ),
        }

        st.session_state[
            "scanner_page"
        ] = 1

        st.session_state[
            "scanner_chart_nonce"
        ] = nonce + 1

        st.rerun()


def _case_page(
    db: Database,
    case_ids: Iterable[int],
    search: str,
    page: int,
) -> tuple[
    int,
    list[dict[str, Any]],
]:
    ids = sorted({
        _integer(value)
        for value in case_ids
        if _integer(value)
    })

    if not ids:
        return 0, []

    placeholders = ",".join(
        "?"
        for _ in ids
    )

    conditions = [
        f"c.id IN ({placeholders})"
    ]

    parameters: list[Any] = [
        *ids,
    ]

    search = search.strip()

    if search:
        value = (
            "%"
            + search.lower()
            + "%"
        )

        conditions.append(
            """
            (
                LOWER(
                    CAST(c.id AS TEXT)
                ) LIKE ?

                OR LOWER(
                    COALESCE(
                        r.full_name,
                        ''
                    )
                ) LIKE ?

                OR LOWER(
                    COALESCE(
                        i.title,
                        ''
                    )
                ) LIKE ?
            )
            """
        )

        parameters.extend(
            [
                value,
                value,
                value,
            ]
        )

    where_sql = (
        "WHERE "
        + " AND ".join(
            conditions
        )
    )

    total = _integer(
        (
            db.one(
                f"""
                SELECT
                    COUNT(*) AS n

                FROM cases c

                JOIN repos r
                  ON r.id=c.repo_id

                JOIN issues i
                  ON i.id=c.issue_id

                {where_sql}
                """,
                tuple(parameters),
            )
            or {}
        ).get("n")
    )

    page = max(
        1,
        int(page),
    )

    offset = (
        page - 1
    ) * PAGE_SIZE

    rows = db.query(
        f"""
        SELECT
            c.id AS case_id,
            r.full_name AS repository,

            SUBSTR(
                COALESCE(
                    i.title,
                    ''
                ),
                1,
                120
            ) AS issue_title,

            c.status,
            c.final_label,

            COALESCE(
                findings.finding_count,
                0
            ) AS finding_count,

            COALESCE(
                findings.introduced_count,
                0
            ) AS introduced_count

        FROM cases c

        JOIN repos r
          ON r.id=c.repo_id

        JOIN issues i
          ON i.id=c.issue_id

        LEFT JOIN (
            SELECT
                case_id,
                COUNT(*) AS finding_count,

                SUM(
                    CASE
                        WHEN COALESCE(
                            introduced,
                            0
                        )=1
                        THEN 1
                        ELSE 0
                    END
                ) AS introduced_count

            FROM scanner_findings

            GROUP BY case_id
        ) findings
          ON findings.case_id=c.id

        {where_sql}

        ORDER BY
            introduced_count DESC,
            finding_count DESC,
            c.updated_at DESC,
            c.id DESC

        LIMIT ?
        OFFSET ?
        """,
        tuple([
            *parameters,
            PAGE_SIZE,
            offset,
        ]),
    )

    return total, rows


def _selected_ids() -> set[int]:
    return {
        int(value)
        for value in st.session_state.get(
            "scanner_selected_case_ids",
            [],
        )
    }


def _store_selected(
    values: set[int],
) -> None:
    st.session_state[
        "scanner_selected_case_ids"
    ] = sorted(values)


def render_scanner_insights(
    settings: Any,
) -> None:
    header, back = st.columns(
        [
            5,
            1,
        ]
    )

    header.title(
        "Scanner Insights"
    )

    if back.button(
        "Back",
        width="stretch",
        key="scanner-back",
    ):
        st.session_state["nav"] = (
            "Overview"
        )

        st.rerun()

    previous_scanner = str(
        st.session_state.get(
            "selected_scanner"
        )
        or "codeql"
    )

    scanner = st.selectbox(
        "Scanner",
        list(SCANNER_ORDER),
        index=(
            list(
                SCANNER_ORDER
            ).index(
                previous_scanner
            )
            if previous_scanner
            in SCANNER_ORDER
            else 0
        ),
        format_func=lambda value: (
            SCANNER_LABELS[value]
        ),
        key="scanner-insight-choice",
    )

    if scanner != previous_scanner:
        st.session_state[
            "scanner_page"
        ] = 1

        st.session_state.pop(
            "scanner_chart_filter",
            None,
        )

        st.session_state[
            "scanner_selected_case_ids"
        ] = []

        st.session_state.pop(
            "scanner_prepared_zip",
            None,
        )

    st.session_state[
        "selected_scanner"
    ] = scanner

    db = Database(
        Path(settings.db_path)
    )

    findings = _finding_rows(
        db,
        scanner,
    )

    finding_cases = {
        _integer(
            row.get("case_id")
        )
        for row in findings
        if _integer(
            row.get("case_id")
        )
    }

    state_sets = _state_sets(
        db,
        scanner,
        finding_cases,
    )

    applicable = state_sets[
        "applicable"
    ]

    active = state_sets[
        "active"
    ]

    errors = state_sets[
        "errors"
    ]

    metrics = st.columns(6)

    metrics[0].metric(
        "Applicable",
        len(applicable),
    )

    metrics[1].metric(
        "Completed",
        (
            f"{max(0, len(applicable) - len(active))}"
            f"/{len(applicable)}"
        ),
    )

    metrics[2].metric(
        "In progress",
        len(active),
    )

    metrics[3].metric(
        "Findings",
        len(findings),
    )

    metrics[4].metric(
        "Positive cases",
        len({
            _integer(
                row.get("case_id")
            )
            for row in findings
            if _integer(
                row.get(
                    "introduced"
                )
            ) == 1
        }),
    )

    metrics[5].metric(
        "Errors",
        len(errors),
    )

    charts = []
    case_maps: dict[
        str,
        dict[str, list[int]],
    ] = {}

    for label, field in _dimensions(
        scanner
    ):
        rows, mapping = _aggregate(
            findings,
            field,
        )

        if rows:
            charts.append(
                (
                    label,
                    rows,
                )
            )

            case_maps[label] = mapping

    if charts:
        tabs = st.tabs(
            [
                label
                for label, _rows
                in charts
            ]
        )

        for tab, (
            label,
            chart_rows,
        ) in zip(
            tabs,
            charts,
        ):
            with tab:
                _interactive_chart(
                    rows=chart_rows,
                    case_map=(
                        case_maps[label]
                    ),
                    scanner=scanner,
                    dimension=label,
                )

    elif applicable:
        st.success(
            (
                f"{len(applicable) - len(active)} "
                "applicable cases completed "
                "without persisted findings."
            )
        )
    else:
        st.info(
            "No applicable cases are "
            "available for this scanner."
        )

    active_filter = (
        st.session_state.get(
            "scanner_chart_filter"
        )
    )

    chart_case_ids: set[int] | None = None

    if (
        isinstance(
            active_filter,
            dict,
        )
        and active_filter.get(
            "scanner"
        ) == scanner
    ):
        chart_case_ids = {
            _integer(value)
            for value in active_filter.get(
                "case_ids",
                [],
            )
            if _integer(value)
        }

        filter_columns = st.columns(
            [
                5,
                1,
            ]
        )

        filter_columns[0].info(
            (
                "Chart filter: "
                + str(
                    active_filter.get(
                        "dimension"
                    )
                    )
                + " = "
                + str(
                    active_filter.get(
                        "value"
                    )
                )
            )
        )

        if filter_columns[1].button(
            "Clear filter",
            width="stretch",
            key="scanner-clear-chart-filter",
        ):
            st.session_state.pop(
                "scanner_chart_filter",
                None,
            )

            st.session_state[
                "scanner_page"
            ] = 1

            st.rerun()

    st.markdown(
        "### Matching cases"
    )

    case_sets = {
        "Findings & errors":
            state_sets[
                "findings_errors"
            ],
        "Findings":
            state_sets["findings"],
        "Errors":
            state_sets["errors"],
        "In progress":
            state_sets["active"],
        "All applicable":
            state_sets[
                "applicable"
            ],
    }

    view = st.selectbox(
        "Case set",
        list(case_sets),
        index=0,
        key=(
            "scanner-case-set-"
            + scanner
        ),
        help=(
            "The default loads only cases "
            "with findings or errors."
        ),
    )

    selected_case_set = set(
        case_sets[view]
    )

    if chart_case_ids is not None:
        selected_case_set &= (
            chart_case_ids
        )

    search = st.text_input(
        "Search cases",
        placeholder=(
            "Case ID, repository or issue title"
        ),
        key=(
            "scanner-case-search-"
            + scanner
        ),
    )

    signature = repr(
        (
            scanner,
            view,
            search,
            sorted(
                chart_case_ids
                or []
            ),
        )
    )

    if (
        st.session_state.get(
            "scanner-case-signature"
        )
        != signature
    ):
        st.session_state[
            "scanner-case-signature"
        ] = signature

        st.session_state[
            "scanner_page"
        ] = 1

    page = max(
        1,
        _integer(
            st.session_state.get(
                "scanner_page",
                1,
            )
        ),
    )

    total, rows = _case_page(
        db,
        selected_case_set,
        search,
        page,
    )

    total_pages = max(
        1,
        math.ceil(
            total / PAGE_SIZE
        ),
    )

    page = min(
        page,
        total_pages,
    )

    st.session_state[
        "scanner_page"
    ] = page

    page_ids = [
        _integer(
            row.get("case_id")
        )
        for row in rows
    ]

    start_row = (
        (page - 1)
        * PAGE_SIZE
        + 1
        if total
        else 0
    )

    end_row = min(
        total,
        page * PAGE_SIZE,
    )

    st.caption(
        (
            f"{start_row}–{end_row} "
            f"of {total} matching cases · "
            f"{PAGE_SIZE} per page"
        )
    )

    selected = _selected_ids()

    toolbar = st.columns(
        [
            1,
            1,
            1.2,
            1.2,
            3,
        ]
    )

    if toolbar[0].button(
        "Select page",
        key="scanner-select-page",
    ):
        selected.update(
            page_ids
        )

        _store_selected(
            selected
        )

        st.rerun()

    if toolbar[1].button(
        "Clear",
        key="scanner-clear-selection",
    ):
        selected.clear()

        _store_selected(
            selected
        )

        st.session_state.pop(
            "scanner_prepared_zip",
            None,
        )

        st.rerun()

    if toolbar[2].button(
        "Review selected",
        disabled=not selected,
        key="scanner-review-selected",
    ):
        queue = sorted(selected)

        st.session_state[
            "review_queue_ids"
        ] = queue

        st.session_state[
            "selected_case_id"
        ] = queue[0]

        st.session_state["nav"] = (
            "Case Review"
        )

        st.rerun()

    if toolbar[3].button(
        "Prepare ZIP",
        disabled=not selected,
        key="scanner-prepare-zip",
    ):
        st.session_state[
            "scanner_prepared_zip"
        ] = selected_evidence_zip(
            db,
            sorted(selected),
        )

    prepared = st.session_state.get(
        "scanner_prepared_zip"
    )

    if prepared is not None:
        toolbar[4].download_button(
            "Download selected evidence",
            data=prepared,
            file_name=(
                f"{scanner}_selected_cases.zip"
            ),
            mime="application/zip",
            width="stretch",
            key="scanner-download-zip",
        )
    else:
        toolbar[4].markdown(
            f"**{len(selected)} selected**"
        )

    if not rows:
        st.info(
            "No cases match the current "
            "scanner, graph and search filters."
        )

    for row in rows:
        case_id = _integer(
            row.get("case_id")
        )

        columns = st.columns(
            [
                0.42,
                0.62,
                1.8,
                4.4,
                0.8,
                0.8,
                0.85,
            ]
        )

        checked = columns[0].checkbox(
            "Select",
            value=(
                case_id in selected
            ),
            key=(
                "scanner-case-"
                f"{scanner}-"
                f"{case_id}"
            ),
            label_visibility="collapsed",
        )

        if checked:
            selected.add(case_id)
        else:
            selected.discard(
                case_id
            )

        columns[1].markdown(
            f"**#{case_id}**"
        )

        columns[2].write(
            str(
                row.get("repository")
                or ""
            )
        )

        columns[3].write(
            str(
                row.get("issue_title")
                or ""
            )
        )

        columns[4].metric(
            "Findings",
            _integer(
                row.get(
                    "finding_count"
                )
            ),
        )

        columns[5].metric(
            "Introduced",
            _integer(
                row.get(
                    "introduced_count"
                )
            ),
        )

        if columns[6].button(
            "Inspect",
            key=(
                "scanner-inspect-"
                f"{scanner}-"
                f"{case_id}"
            ),
            width="stretch",
        ):
            st.session_state[
                "selected_case_id"
            ] = case_id

            st.session_state[
                "review_queue_ids"
            ] = sorted(
                selected_case_set
            )

            st.session_state["nav"] = (
                "Case Review"
            )

            st.rerun()

    _store_selected(selected)

    previous, centre, next_page = (
        st.columns(
            [
                1,
                3,
                1,
            ]
        )
    )

    if previous.button(
        "Previous",
        disabled=page <= 1,
        key="scanner-previous",
        width="stretch",
    ):
        st.session_state[
            "scanner_page"
        ] = page - 1

        st.rerun()

    centre.markdown(
        (
            "<div style='text-align:center;"
            "padding-top:.42rem'>"
            f"<strong>Page {page} "
            f"of {total_pages}</strong>"
            "</div>"
        ),
        unsafe_allow_html=True,
    )

    if next_page.button(
        "Next",
        disabled=(
            page >= total_pages
        ),
        key="scanner-next",
        width="stretch",
    ):
        st.session_state[
            "scanner_page"
        ] = page + 1

        st.rerun()
