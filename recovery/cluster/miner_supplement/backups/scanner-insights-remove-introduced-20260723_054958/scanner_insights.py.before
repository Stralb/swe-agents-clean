PAGE_SIZE = 25

SCANNER_ORDER = (
    "gitleaks",
    "dependency-diff",
    "osv-scanner",
    "semgrep",
    "trivy",
    "codeql",
)

SCANNER_LABELS = {
    "gitleaks": "Gitleaks",
    "dependency-diff": "Dependency diff",
    "osv-scanner": "OSV",
    "semgrep": "Semgrep",
    "trivy": "Trivy",
    "codeql": "CodeQL",
}

SCANNER_JOB_TYPES = {
    "gitleaks": (
        "secret_ci",
    ),
    "dependency-diff": (
        "dependency_downgrade",
    ),
    "osv-scanner": (
        "osv_dependency",
    ),
    "semgrep": (
        "semgrep_source",
        "semgrep_script",
    ),
    "trivy": (
        "trivy_dependency",
        "trivy_vuln",
        "trivy_secret",
        "trivy_misconfig",
    ),
    "codeql": (
        "codeql_security",
        "codeql",
    ),
}

ACTIVE_STATUSES = {
    "",
    "pending",
    "queued",
    "claimed",
    "running",
    "processing",
    "active",
    "retrying",
    "created",
}

NOT_APPLICABLE = {
    "not_applicable",
    "not-applicable",
    "skipped",
    "disabled",
}

ERROR_WORDS = (
    "error",
    "fail",
    "timeout",
    "blocked",
    "crash",
)

DEPENDENCY_FILES = {
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts",
    "gradle.lockfile",
    "requirements.txt",
    "requirements-dev.txt",
    "pipfile",
    "pipfile.lock",
    "poetry.lock",
    "pyproject.toml",
    "cargo.toml",
    "cargo.lock",
    "go.mod",
    "go.sum",
    "gemfile",
    "gemfile.lock",
    "composer.json",
    "composer.lock",
}


def _integer(
    value: Any,
) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _text(
    value: Any,
) -> str:
    text = str(value or "").strip()

    if text.lower() in {
        "",
        "unknown",
        "unspecified",
        "unclassified",
        "none",
        "null",
        "n/a",
    }:
        return ""

    return text


def _json(
    value: Any,
) -> Any:
    if isinstance(
        value,
        (
            dict,
            list,
        ),
    ):
        return value

    text = str(value or "").strip()

    if not text:
        return None

    try:
        return json.loads(text)
    except Exception:
        return None


def _canonical_scanner(
    value: Any,
) -> str:
    scanner = (
        str(value or "")
        .strip()
        .lower()
        .replace("_", "-")
    )

    if scanner.startswith("codeql"):
        return "codeql"

    aliases = {
        "dependency-downgrade":
            "dependency-diff",
        "osv":
            "osv-scanner",
        "osv-dependency":
            "osv-scanner",
        "secret-ci":
            "gitleaks",
        "semgrep-source":
            "semgrep",
        "semgrep-script":
            "semgrep",
        "trivy-scanner":
            "trivy",
        "trivy-dependency":
            "trivy",
        "trivy-vuln":
            "trivy",
        "trivy-secret":
            "trivy",
        "trivy-misconfig":
            "trivy",
    }

    return aliases.get(
        scanner,
        scanner,
    )


def _is_error(
    value: Any,
) -> bool:
    status = str(value or "").lower()

    return any(
        word in status
        for word in ERROR_WORDS
    )


def _normalise_path(
    value: Any,
) -> str:
    return (
        str(value or "")
        .strip()
        .replace("\\", "/")
        .lstrip("./")
    )


def _file_area(
    value: Any,
) -> str:
    path = _normalise_path(
        value
    ).lower()

    name = path.rsplit(
        "/",
        1,
    )[-1]

    if name in DEPENDENCY_FILES:
        if (
            "lock" in name
            or name in {
                "go.sum",
                "gradle.lockfile",
            }
        ):
            return "Dependency lockfile"

        return "Dependency manifest"

    if (
        path.startswith(
            ".github/workflows/"
        )
        or "/.github/workflows/"
        in path
    ):
        return "CI workflow"

    if (
        name.startswith(".env")
        or "credential" in name
        or "secret" in name
        or "token" in name
    ):
        return "Secret/configuration"

    if (
        path.startswith("src/")
        or path.startswith("lib/")
        or path.startswith("app/")
        or "/src/" in path
        or "/lib/" in path
    ):
        return "Project source"

    if (
        path.startswith("test/")
        or path.startswith("tests/")
        or "/test/" in path
        or "/tests/" in path
        or ".test." in name
        or ".spec." in name
        or name.endswith("_test.py")
    ):
        return "Test code"

    if (
        path.startswith("docs/")
        or "/docs/" in path
        or name.endswith(
            (
                ".md",
                ".rst",
                ".adoc",
            )
        )
    ):
        return "Documentation"

    if (
        "config" in name
        or path.startswith(".github/")
        or name in {
            "dockerfile",
            "makefile",
            "compose.yml",
            "compose.yaml",
        }
    ):
        return "Build/configuration"

    return "Other changed file"


def _finding_rows(
    db: Database,
    scanner: str,
) -> list[dict[str, Any]]:
    rows = db.query(
        """
        SELECT
            sf.*,
            r.full_name AS repository,
            i.title AS issue_title

        FROM scanner_findings sf

        LEFT JOIN cases c
          ON c.id=sf.case_id

        LEFT JOIN repos r
          ON r.id=c.repo_id

        LEFT JOIN issues i
          ON i.id=c.issue_id

        ORDER BY sf.id DESC
        """
    )

    parsed_rows: list[
        dict[str, Any]
    ] = []

    for row in rows:
        if (
            _canonical_scanner(
                row.get("scanner")
            )
            != scanner
        ):
            continue

        evidence = _json(
            row.get("evidence")
        )

        raw = _json(
            row.get("raw_json")
        )

        if not isinstance(
            evidence,
            dict,
        ):
            evidence = {}

        if not isinstance(
            raw,
            dict,
        ):
            raw = {}

        database_specific = raw.get(
            "database_specific"
        )

        if not isinstance(
            database_specific,
            dict,
        ):
            database_specific = {}

        aliases = raw.get(
            "aliases"
        )

        if not isinstance(
            aliases,
            list,
        ):
            aliases = []

        cwe_values = (
            database_specific.get(
                "cwe_ids"
            )
        )

        if not isinstance(
            cwe_values,
            list,
        ):
            cwe_values = []

        affected = raw.get(
            "affected"
        )

        if not isinstance(
            affected,
            list,
        ):
            affected = []

        package = _text(
            evidence.get("package")
            or raw.get("PkgName")
            or raw.get("pkgName")
        )

        ecosystem = ""
        fixed_versions: set[str] = set()

        for affected_item in affected:
            if not isinstance(
                affected_item,
                dict,
            ):
                continue

            package_data = (
                affected_item.get(
                    "package"
                )
            )

            if isinstance(
                package_data,
                dict,
            ):
                if not package:
                    package = _text(
                        package_data.get(
                            "name"
                        )
                    )

                if not ecosystem:
                    ecosystem = _text(
                        package_data.get(
                            "ecosystem"
                        )
                    )

            ranges = affected_item.get(
                "ranges"
            )

            if not isinstance(
                ranges,
                list,
            ):
                continue

            for range_item in ranges:
                if not isinstance(
                    range_item,
                    dict,
                ):
                    continue

                events = range_item.get(
                    "events"
                )

                if not isinstance(
                    events,
                    list,
                ):
                    continue

                for event in events:
                    if (
                        isinstance(
                            event,
                            dict,
                        )
                        and event.get(
                            "fixed"
                        )
                    ):
                        fixed_versions.add(
                            str(
                                event[
                                    "fixed"
                                ]
                            )
                        )

        severity = _text(
            row.get("severity")
            or database_specific.get(
                "severity"
            )
            or raw.get("Severity")
        )

        vulnerability = _text(
            evidence.get("vuln_id")
            or raw.get("id")
            or raw.get(
                "VulnerabilityID"
            )
            or row.get("rule_id")
        )

        cwe = _text(
            row.get("cwe")
            or ", ".join(
                str(value)
                for value in cwe_values
            )
            or ", ".join(
                str(value)
                for value in (
                    raw.get("CweIDs")
                    or []
                )
            )
        )

        change_type = _text(
            evidence.get(
                "change_type"
            )
            or raw.get(
                "change_type"
            )
        )

        old_version = _text(
            evidence.get(
                "old_version"
            )
            or raw.get(
                "old_version"
            )
        )

        new_version = _text(
            evidence.get(
                "new_version"
            )
            or raw.get(
                "new_version"
            )
        )

        version = _text(
            evidence.get("version")
            or raw.get(
                "InstalledVersion"
            )
            or raw.get("version")
        )

        fixed_version = _text(
            raw.get("FixedVersion")
            or ", ".join(
                sorted(
                    fixed_versions
                )
            )
        )

        rule = _text(
            row.get("rule_id")
            or vulnerability
            or change_type
            or row.get(
                "finding_type"
            )
        )

        description = _text(
            row.get("description")
            or raw.get("Title")
            or raw.get("Description")
        )

        file_path = _normalise_path(
            row.get("file_path")
            or raw.get("Target")
        )

        line = _text(
            row.get("line")
        )

        detail_parts = []

        if description:
            detail_parts.append(
                description[:300]
            )

        if package:
            package_detail = package

            if version:
                package_detail += (
                    "@" + version
                )

            detail_parts.append(
                "Package: "
                + package_detail
            )

        if (
            old_version
            or new_version
        ):
            detail_parts.append(
                "Version: "
                + (
                    old_version
                    or "?"
                )
                + " → "
                + (
                    new_version
                    or "?"
                )
            )

        if fixed_version:
            detail_parts.append(
                "Fixed: "
                + fixed_version
            )

        if aliases:
            detail_parts.append(
                "Aliases: "
                + ", ".join(
                    str(value)
                    for value in aliases[
                        :5
                    ]
                )
            )

        if file_path:
            location = file_path

            if line:
                location += (
                    ":" + line
                )

            detail_parts.append(
                "Location: "
                + location
            )

        parsed_rows.append({
            **row,
            "scanner_normalised":
                scanner,
            "rule":
                rule,
            "vulnerability":
                vulnerability,
            "severity_clean":
                severity,
            "cwe_clean":
                cwe,
            "package":
                package,
            "ecosystem":
                ecosystem,
            "change_type":
                change_type,
            "old_version":
                old_version,
            "new_version":
                new_version,
            "version":
                version,
            "fixed_version":
                fixed_version,
            "aliases":
                ", ".join(
                    str(value)
                    for value
                    in aliases[:5]
                ),
            "file_area":
                _file_area(
                    file_path
                ),
            "file_path_clean":
                file_path,
            "detail":
                " | ".join(
                    detail_parts
                ),
        })

    return parsed_rows


def _dimension_values(
    value: Any,
) -> list[str]:
    text = _text(value)

    if not text:
        return []

    if "," in text:
        return [
            item.strip()
            for item in text.split(",")
            if item.strip()
        ]

    return [text]


def _aggregate(
    findings: list[
        dict[str, Any]
    ],
    field: str,
) -> tuple[
    list[dict[str, Any]],
    dict[str, list[int]],
]:
    groups: dict[
        str,
        list[dict[str, Any]],
    ] = defaultdict(list)

    for finding in findings:
        for value in _dimension_values(
            finding.get(field)
        ):
            groups[value].append(
                finding
            )

    chart_rows = []
    case_map: dict[
        str,
        list[int],
    ] = {}

    for name, group in groups.items():
        case_ids = sorted({
            _integer(
                row.get("case_id")
            )
            for row in group
            if _integer(
                row.get("case_id")
            )
        })

        details = []
        packages = []
        files = []
        versions = []
        identifiers = []

        for row in group:
            detail = _text(
                row.get("detail")
            )

            if (
                detail
                and detail not in details
            ):
                details.append(detail)

            package = _text(
                row.get("package")
            )

            if (
                package
                and package not in packages
            ):
                packages.append(package)

            file_path = _text(
                row.get(
                    "file_path_clean"
                )
            )

            if (
                file_path
                and file_path not in files
            ):
                files.append(file_path)

            old_version = _text(
                row.get("old_version")
            )

            new_version = _text(
                row.get("new_version")
            )

            if (
                old_version
                or new_version
            ):
                version = (
                    (old_version or "?")
                    + " → "
                    + (new_version or "?")
                )

                if version not in versions:
                    versions.append(version)

            identifier = _text(
                row.get("vulnerability")
                or row.get("cwe_clean")
                or row.get("rule")
            )

            if (
                identifier
                and identifier
                not in identifiers
            ):
                identifiers.append(
                    identifier
                )

        chart_rows.append({
            "name": name,
            "findings": len(group),
            "cases": len(case_ids),
            "introduced": sum(
                1
                for row in group
                if _integer(
                    row.get(
                        "introduced"
                    )
                ) == 1
            ),
            "details": (
                " | ".join(
                    details[:2]
                )[:650]
            ),
            "packages": ", ".join(
                packages[:5]
            ),
            "files": ", ".join(
                files[:5]
            ),
            "versions": ", ".join(
                versions[:5]
            ),
            "identifiers": ", ".join(
                identifiers[:5]
            ),
        })

        case_map[name] = case_ids

    chart_rows.sort(
        key=lambda row: (
            -row["findings"],
            row["name"],
        )
    )

    return chart_rows, case_map


