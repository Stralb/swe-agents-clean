from __future__ import annotations

import html
import re
from typing import Iterable, Mapping, Sequence

import streamlit as st

SIGNAL_COLORS = {
    "dependency": "#ea580c",
    "secret": "#dc2626",
    "ci": "#dc2626",
    "sast": "#16a34a",
    "source-code": "#16a34a",
    "source": "#16a34a",
    "vulnerability": "#0f766e",
    "codeql": "#0f766e",
}


def safe_markdown(text: str | None, *, max_chars: int = 30000) -> None:
    """Render user-provided GitHub markdown in a readable container.

    Streamlit sanitizes markdown HTML by default when unsafe_allow_html=False.
    We cap very long content to keep review pages responsive.
    """
    body = (text or "").strip()
    if not body:
        st.info("No body text stored.")
        return
    truncated = len(body) > max_chars
    body = body[:max_chars]
    st.markdown(body)
    if truncated:
        st.caption(f"Showing first {max_chars:,} characters to keep the UI responsive. Export the case for full evidence.")


def _finding_color(finding: Mapping) -> str:
    blob = " ".join(str(finding.get(k) or "") for k in ("finding_type", "scanner", "rule_id", "description")).lower()
    for key, color in SIGNAL_COLORS.items():
        if key in blob:
            return color
    return "#f59e0b"


def _line_matches(file_path: str, line_no: int | None, finding: Mapping) -> bool:
    if line_no is None:
        return False
    fpath = str(finding.get("file_path") or "")
    if fpath and fpath != file_path and not fpath.endswith(file_path) and not file_path.endswith(fpath):
        return False
    try:
        start = int(finding.get("line") or finding.get("start_line") or 0)
    except Exception:
        start = 0
    try:
        end = int(finding.get("end_line") or start)
    except Exception:
        end = start
    return bool(start and start <= line_no <= max(start, end))


def _hunk_new_start(line: str) -> int | None:
    match = re.search(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", line)
    if not match:
        return None
    return int(match.group(1))


def render_diff(patch: str | None, *, max_lines: int = 420, file_path: str = "", findings: Sequence[Mapping] | None = None) -> None:
    """Render a unified diff with readable coloring and scanner overlays.

    When findings include file_path + line, matching added/context lines are
    highlighted and annotated inline. This keeps scanner evidence attached to the
    actual downstream change being reviewed.
    """
    if not patch:
        st.info("No patch stored for this file.")
        return
    findings = list(findings or [])
    lines = patch.splitlines()
    truncated = len(lines) > max_lines
    lines = lines[:max_lines]
    html_lines: list[str] = []
    new_line: int | None = None
    for line in lines:
        cls = "ctx"
        line_no_for_match: int | None = None
        if line.startswith("+++") or line.startswith("---"):
            cls = "file"
        elif line.startswith("@@"):
            cls = "hunk"
            start = _hunk_new_start(line)
            new_line = start
        elif line.startswith("+"):
            cls = "add"
            line_no_for_match = new_line
            if new_line is not None:
                new_line += 1
        elif line.startswith("-"):
            cls = "del"
        else:
            line_no_for_match = new_line
            if new_line is not None:
                new_line += 1

        matched = [f for f in findings if _line_matches(file_path, line_no_for_match, f)]
        style = ""
        annotation = ""
        if matched:
            color = _finding_color(matched[0])
            style = f" border-left:4px solid {color}; background:{color}24;"
            labels = []
            for f in matched[:3]:
                scanner = html.escape(str(f.get("scanner") or "scanner"))
                desc = html.escape(str(f.get("description") or f.get("rule_id") or f.get("finding_type") or "finding")[:180])
                labels.append(f'<span class="diff-finding" style="border-color:{_finding_color(f)}; color:{_finding_color(f)};">{scanner}: {desc}</span>')
            annotation = " " + " ".join(labels)
        prefix = html.escape(line[:1]) if line else ""
        body = html.escape(line[1:] if line else "")
        html_lines.append(f'<div class="diff-line diff-{cls}" style="{style}"><span class="diff-prefix">{prefix}</span>{body}{annotation}</div>')
    if truncated:
        html_lines.append(f'<div class="diff-line diff-hunk">... truncated after {max_lines} lines. Export case for full patch.</div>')
    st.markdown('<div class="diff-box">' + "".join(html_lines) + '</div>', unsafe_allow_html=True)


def compact_tags(tags: Iterable[str]) -> str:
    clean = [str(t) for t in tags if str(t).strip()]
    return ", ".join(clean) if clean else "None"
