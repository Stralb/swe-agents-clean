from __future__ import annotations

import hashlib
import json
import math
import re
from collections import defaultdict
from pathlib import Path
from typing import Any, Iterable

import streamlit as st

from src.db.database import Database


SCANNER_LABELS = {
    "gitleaks": "Gitleaks",
    "dependency-diff": "Dependency diff",
    "osv-scanner": "OSV",
    "semgrep": "Semgrep",
    "codeql": "CodeQL",
    "trivy": "Trivy",
}

SCANNER_ORDER = (
    "gitleaks",
    "dependency-diff",
    "osv-scanner",
    "semgrep",
    "trivy",
    "codeql",
)

CHEAP_SCANNERS = (
    "gitleaks",
    "dependency-diff",
    "osv-scanner",
    "semgrep",
    "trivy",
)

ROUTE_TO_SCANNER = {
    "semgrep_source": "semgrep",
    "semgrep_script": "semgrep",
    "codeql": "codeql",
    "dependency_downgrade": "dependency-diff",
    "osv_dependency": "osv-scanner",
    "secret_ci": "gitleaks",
    "trivy": "trivy",
    "trivy-scanner": "trivy",
    "trivy_vuln": "trivy",
    "trivy_secret": "trivy",
    "trivy_misconfig": "trivy",
}

JOB_TO_SCANNER = {
    "semgrep_source": "semgrep",
    "semgrep_script": "semgrep",
    "secret_ci": "gitleaks",
    "dependency_downgrade": "dependency-diff",
    "osv_dependency": "osv-scanner",
    "trivy_dependency": "trivy",
    "codeql_security": "codeql",
}

ACTIVE_STATUSES = {
    "",
    "pending",
    "queued",
    "claimed",
    "running",
    "processing",
    "active",
    "retrying",
    "created",
}

ERROR_WORDS = (
    "error",
    "failed",
    "failure",
    "timeout",
    "blocked",
    "missing",
    "unavailable",
    "crashed",
)

POSITIVE_LABEL_WORDS = (
    "suspicious",
    "malicious",
    "security regression",
    "high-confidence",
    "high confidence",
    "confirmed positive",
)

DEPENDENCY_FILES = {
    "package.json",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts",
    "gradle.lockfile",
    "requirements.txt",
    "requirements-dev.txt",
    "pipfile",
    "pipfile.lock",
    "poetry.lock",
    "pyproject.toml",
    "cargo.toml",
    "cargo.lock",
    "go.mod",
    "go.sum",
    "gemfile",
    "gemfile.lock",
    "composer.json",
    "composer.lock",
}


def integer(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def normalise_scanner(value: Any) -> str:
    scanner = str(value or "").strip().lower()

    aliases = {
        "osv": "osv-scanner",
        "osv_scanner": "osv-scanner",
        "dependency_diff": "dependency-diff",
        "dependency-downgrade": "dependency-diff",
        "codeql-security": "codeql",
        "semgrep-source": "semgrep",
        "trivy-scanner": "trivy",
        "trivy_dependency": "trivy",
        "trivy-dependency": "trivy",
    }

    return aliases.get(scanner, scanner)


def parse_list(value: Any) -> list[str]:
    if value is None:
        return []

    if isinstance(value, list):
        return [
            str(item).strip()
            for item in value
            if str(item).strip()
        ]

    if isinstance(value, tuple):
        return [
            str(item).strip()
            for item in value
            if str(item).strip()
        ]

    text = str(value).strip()

    if not text:
        return []

    try:
        parsed = json.loads(text)

        if isinstance(parsed, list):
            return [
                str(item).strip()
                for item in parsed
                if str(item).strip()
            ]
    except Exception:
        pass

    return [
        item.strip()
        for item in re.split(
            r"[,;|]",
            text,
        )
        if item.strip()
    ]


def terminal_status(value: Any) -> bool:
    status = str(value or "").strip().lower()
    return status not in ACTIVE_STATUSES


def error_status(value: Any) -> bool:
    status = str(value or "").strip().lower()

    return any(
        word in status
        for word in ERROR_WORDS
    )


def normalise_path(value: Any) -> str:
    return (
        str(value or "")
        .strip()
        .replace("\\", "/")
        .lstrip("./")
        .lower()
    )


def path_pattern(value: Any) -> str:
    path = normalise_path(value)
    name = path.rsplit("/", 1)[-1]

    if name in DEPENDENCY_FILES:
        if "lock" in name or name in {
            "go.sum",
            "gradle.lockfile",
        }:
            return "Dependency lockfile"

        return "Dependency manifest"

    if (
        path.startswith(".github/workflows/")
        or "/.github/workflows/" in path
    ):
        return "CI workflow"

    if (
        name.startswith(".env")
        or "secret" in name
        or "credential" in name
        or "token" in name
    ):
        return "Secret/config file"

    if (
        path.startswith("test/")
        or path.startswith("tests/")
        or "/test/" in path
        or "/tests/" in path
        or name.endswith((
            ".test.js",
            ".test.ts",
            ".spec.js",
            ".spec.ts",
            "_test.py",
        ))
    ):
        return "Test code"

    if (
        path.startswith("src/")
        or path.startswith("lib/")
        or path.startswith("app/")
        or "/src/" in path
        or "/lib/" in path
    ):
        return "Project source"

    if (
        path.startswith("docs/")
        or "/docs/" in path
        or name.endswith((
            ".md",
            ".rst",
            ".adoc",
        ))
    ):
        return "Documentation"

    if (
        path.startswith("vendor/")
        or "/vendor/" in path
        or path.startswith("dist/")
        or "/dist/" in path
        or ".min." in name
    ):
        return "Generated/vendor"

    if (
        "config" in name
        or name in {
            "makefile",
            "dockerfile",
            "compose.yml",
            "compose.yaml",
        }
        or path.startswith(".github/")
    ):
        return "Build/configuration"

    return "Other changed file"


def finding_is_security(row: dict[str, Any]) -> bool:
    scanner = normalise_scanner(
        row.get("scanner")
    )

    cwe = str(
        row.get("cwe")
        or ""
    ).strip()

    if cwe:
        return True

    if scanner in {
        "gitleaks",
        "osv-scanner",
    }:
        return True

    text = " ".join(
        str(
            row.get(key)
            or ""
        )
        for key in (
            "finding_type",
            "severity",
            "rule_id",
            "description",
        )
    ).lower()

    security_terms = (
        "security",
        "vulnerability",
        "secret",
        "credential",
        "injection",
        "xss",
        "cross-site",
        "sql injection",
        "command injection",
        "path traversal",
        "deserial",
        "authentication",
        "authorization",
        "permission",
        "cwe-",
    )

    return any(
        term in text
        for term in security_terms
    )


def manually_positive(
    final_label: Any,
) -> bool:
    label = str(
        final_label
        or ""
    ).strip().lower()

    return bool(label) and any(
        word in label
        for word in POSITIVE_LABEL_WORDS
    )


def safe_query(
    db: Database,
    query: str,
    parameters: Iterable[Any] = (),
) -> list[dict[str, Any]]:
    try:
        return db.query(
            query,
            tuple(parameters),
        )
    except Exception:
        return []


def safe_one(
    db: Database,
    query: str,
    parameters: Iterable[Any] = (),
) -> dict[str, Any]:
    try:
        return db.one(
            query,
            tuple(parameters),
        ) or {}
    except Exception:
        return {}


def table_columns(
    db: Database,
    table: str,
) -> set[str]:
    return {
        str(row.get("name"))
        for row in safe_query(
            db,
            f"PRAGMA table_info({table})",
        )
        if row.get("name")
    }


def latest_runs(
    db: Database,
) -> dict[
    tuple[int, str],
    dict[str, Any],
]:
    case_by_pr = {
        integer(row.get("pr_id")):
        integer(row.get("case_id"))
        for row in safe_query(
            db,
            """
            SELECT
                id AS case_id,
                pr_id
            FROM cases
            """,
        )
    }

    rows = safe_query(
        db,
        """
        SELECT
            id,
            case_id,
            pr_id,
            scanner,
            status,
            started_at,
            finished_at,
            stdout,
            stderr
        FROM scanner_runs
        ORDER BY id DESC
        """,
    )

    result: dict[
        tuple[int, str],
        dict[str, Any],
    ] = {}

    for row in rows:
        case_id = integer(
            row.get("case_id")
        )

        if not case_id:
            case_id = case_by_pr.get(
                integer(
                    row.get("pr_id")
                ),
                0,
            )

        scanner = normalise_scanner(
            row.get("scanner")
        )

        if (
            not case_id
            or not scanner
        ):
            continue

        result.setdefault(
            (
                case_id,
                scanner,
            ),
            row,
        )

    return result


def scanner_eligibility(
    db: Database,
) -> tuple[
    dict[str, set[int]],
    dict[int, set[str]],
]:
    eligible: dict[
        str,
        set[int],
    ] = defaultdict(set)

    case_routes: dict[
        int,
        set[str],
    ] = defaultdict(set)

    for row in safe_query(
        db,
        """
        SELECT
            case_id,
            scanner_routes
        FROM artifact_regions
        """,
    ):
        case_id = integer(
            row.get("case_id")
        )

        for route in parse_list(
            row.get("scanner_routes")
        ):
            scanner = ROUTE_TO_SCANNER.get(
                route,
            )

            if not scanner:
                continue

            eligible[scanner].add(
                case_id
            )

            case_routes[case_id].add(
                scanner
            )

    for row in safe_query(
        db,
        """
        SELECT
            case_id,
            job_type
        FROM scanner_jobs
        """,
    ):
        scanner = JOB_TO_SCANNER.get(
            str(
                row.get("job_type")
                or ""
            )
        )

        case_id = integer(
            row.get("case_id")
        )

        if scanner and case_id:
            eligible[scanner].add(
                case_id
            )

            case_routes[case_id].add(
                scanner
            )

    runs = latest_runs(db)

    for (
        case_id,
        scanner,
    ) in runs:
        eligible[scanner].add(
            case_id
        )

    return (
        dict(eligible),
        dict(case_routes),
    )


@st.cache_data(
    ttl=3,
    show_spinner=False,
)
def load_live_overview(
    db_path: str,
) -> dict[str, Any]:
    db = Database(
        Path(db_path)
    )

    cases = safe_query(
        db,
        """
        SELECT
            c.id AS case_id,
            c.status,
            c.final_label
        FROM cases c
        """,
    )

    runs = latest_runs(db)

    findings = safe_query(
        db,
        """
        SELECT
            case_id,
            introduced
        FROM scanner_findings
        """,
    )

    positive_cases = {
        integer(row.get("case_id"))
        for row in findings
        if integer(
            row.get("introduced")
        ) == 1
    }

    problem_cases = {
        case_id
        for (
            case_id,
            _scanner,
        ), row in runs.items()
        if error_status(
            row.get("status")
        )
    }

    reviewed = {
        integer(
            row.get("case_id")
        )
        for row in cases
        if (
            str(
                row.get("status")
                or ""
            ).lower() == "reviewed"
            or str(
                row.get("final_label")
                or ""
            ).strip()
        )
    }

    needs_review = {
        integer(
            row.get("case_id")
        )
        for row in cases
        if str(
            row.get("status")
            or ""
        ).lower() == "needs_review"
    }

    eligible, case_routes = (
        scanner_eligibility(db)
    )

    finding_rows = safe_query(
        db,
        """
        SELECT
            case_id,
            scanner,
            introduced
        FROM scanner_findings
        """,
    )

    scanner_findings: dict[
        str,
        int,
    ] = defaultdict(int)

    scanner_positive_cases: dict[
        str,
        set[int],
    ] = defaultdict(set)

    for row in finding_rows:
        scanner = normalise_scanner(
            row.get("scanner")
        )

        if not scanner:
            continue

        scanner_findings[scanner] += 1

        if integer(
            row.get("introduced")
        ) == 1:
            scanner_positive_cases[
                scanner
            ].add(
                integer(
                    row.get("case_id")
                )
            )

    scanners: list[
        dict[str, Any]
    ] = []

    for scanner in SCANNER_ORDER:
        eligible_cases = set(
            eligible.get(
                scanner,
                set(),
            )
        )

        if not eligible_cases:
            eligible_cases = {
                case_id
                for (
                    case_id,
                    run_scanner,
                ) in runs
                if run_scanner == scanner
            }

        terminal_cases = {
            case_id
            for case_id in eligible_cases
            if terminal_status(
                runs.get(
                    (
                        case_id,
                        scanner,
                    ),
                    {},
                ).get(
                    "status"
                )
            )
        }

        error_cases = {
            case_id
            for case_id in eligible_cases
            if error_status(
                runs.get(
                    (
                        case_id,
                        scanner,
                    ),
                    {},
                ).get(
                    "status"
                )
            )
        }

        scanners.append({
            "scanner": scanner,
            "label": SCANNER_LABELS.get(
                scanner,
                scanner,
            ),
            "eligible": len(
                eligible_cases
            ),
            "terminal": len(
                terminal_cases
            ),
            "errors": len(
                error_cases
            ),
            "findings": integer(
                scanner_findings.get(
                    scanner,
                    0,
                )
            ),
            "positive_cases": len(
                scanner_positive_cases.get(
                    scanner,
                    set(),
                )
            ),
        })

    cheap_cases = set()

    for scanner in CHEAP_SCANNERS:
        cheap_cases.update(
            eligible.get(
                scanner,
                set(),
            )
        )

    cheap_terminal = 0

    for case_id in cheap_cases:
        required = {
            scanner
            for scanner in case_routes.get(
                case_id,
                set(),
            )
            if scanner in CHEAP_SCANNERS
        }

        if (
            required
            and all(
                terminal_status(
                    runs.get(
                        (
                            case_id,
                            scanner,
                        ),
                        {},
                    ).get(
                        "status"
                    )
                )
                for scanner in required
            )
        ):
            cheap_terminal += 1

    return {
        "summary": {
            "cases": len(cases),
            "needs_review": len(
                needs_review
            ),
            "positive_cases": len(
                positive_cases
            ),
            "reviewed": len(reviewed),
            "problem_cases": len(
                problem_cases
            ),
        },
        "scanners": scanners,
        "cheap": {
            "eligible": len(
                cheap_cases
            ),
            "terminal": cheap_terminal,
        },
    }


def _case_metadata(
    db: Database,
) -> dict[int, dict[str, Any]]:
    rows = safe_query(
        db,
        """
        SELECT
            c.id AS case_id,
            c.issue_id,
            c.pr_id,
            c.status,
            c.final_label,
            c.ai_cohort,
            c.downstream_signal,
            r.id AS repo_id,
            r.full_name AS repository,
            r.language AS repository_language
        FROM cases c
        JOIN repos r
          ON r.id = c.repo_id
        """,
    )

    return {
        integer(row.get("case_id")):
        row
        for row in rows
    }


def _ai_marker_rows(
    db: Database,
    cases: dict[
        int,
        dict[str, Any],
    ],
) -> list[
    tuple[int, str]
]:
    columns = table_columns(
        db,
        "ai_markers",
    )

    if not columns:
        return []

    rows = safe_query(
        db,
        "SELECT * FROM ai_markers",
    )

    issue_map = {
        integer(
            case.get("issue_id")
        ): case_id
        for case_id, case in (
            cases.items()
        )
    }

    pr_map = {
        integer(
            case.get("pr_id")
        ): case_id
        for case_id, case in (
            cases.items()
        )
    }

    value_columns = (
        "matched_tool",
        "tool",
        "marker",
        "marker_type",
        "value",
        "source",
    )

    result: list[
        tuple[int, str]
    ] = []

    for row in rows:
        case_id = integer(
            row.get("case_id")
        )

        if not case_id:
            case_id = issue_map.get(
                integer(
                    row.get("issue_id")
                ),
                0,
            )

        if not case_id:
            case_id = pr_map.get(
                integer(
                    row.get("pr_id")
                ),
                0,
            )

        if not case_id:
            continue

        marker = ""

        for key in value_columns:
            candidate = str(
                row.get(key)
                or ""
            ).strip()

            if candidate:
                marker = candidate
                break

        if marker:
            result.append(
                (
                    case_id,
                    marker,
                )
            )

    return result


def _extract_identify_tags(
    value: Any,
) -> list[str]:
    text = str(
        value
        or ""
    ).strip()

    if not text:
        return []

    candidates: list[Any] = []

    try:
        parsed = json.loads(text)

        if isinstance(parsed, dict):
            for key in (
                "tags",
                "identify_tags",
                "file_tags",
                "identify",
            ):
                candidate = parsed.get(
                    key
                )

                if candidate is not None:
                    candidates.append(
                        candidate
                    )
    except Exception:
        pass

    result: list[str] = []

    for candidate in candidates:
        result.extend(
            parse_list(candidate)
        )

    return sorted(
        {
            tag.strip()
            for tag in result
            if tag.strip()
        }
    )


def _confidence_label(
    case_count: int,
    repo_count: int,
) -> str:
    if (
        case_count < 5
        or repo_count < 2
    ):
        return "Low sample"

    if (
        case_count < 10
        or repo_count < 3
    ):
        return "Emerging"

    if case_count < 20:
        return "Moderate"

    return "Higher support"


def _pattern_id(
    family: str,
    name: str,
) -> str:
    digest = hashlib.sha1(
        (
            family
            + "\0"
            + name
        ).encode(
            "utf-8"
        )
    ).hexdigest()[:16]

    return digest


@st.cache_data(
    ttl=15,
    show_spinner=False,
)
def load_patterns(
    db_path: str,
) -> list[dict[str, Any]]:
    db = Database(
        Path(db_path)
    )

    cases = _case_metadata(db)

    artifacts = safe_query(
        db,
        """
        SELECT
            case_id,
            path,
            region,
            language,
            scanner_routes,
            confidence,
            evidence
        FROM artifact_regions
        """,
    )

    findings = safe_query(
        db,
        """
        SELECT
            case_id,
            scanner,
            finding_type,
            severity,
            rule_id,
            cwe,
            file_path,
            description,
            introduced
        FROM scanner_findings
        """,
    )

    runs = latest_runs(db)
    _eligible, case_routes = (
        scanner_eligibility(db)
    )

    introduced = {
        integer(row.get("case_id"))
        for row in findings
        if integer(
            row.get("introduced")
        ) == 1
    }

    security = {
        integer(row.get("case_id"))
        for row in findings
        if (
            integer(
                row.get("introduced")
            ) == 1
            and finding_is_security(row)
        )
    }

    quality = {
        integer(row.get("case_id"))
        for row in findings
        if (
            integer(
                row.get("introduced")
            ) == 1
            and not finding_is_security(
                row
            )
        )
    }

    manual_positive = {
        case_id
        for case_id, case in (
            cases.items()
        )
        if manually_positive(
            case.get("final_label")
        )
    }

    reviewed = {
        case_id
        for case_id, case in (
            cases.items()
        )
        if (
            str(
                case.get("final_label")
                or ""
            ).strip()
            or str(
                case.get("status")
                or ""
            ).lower() == "reviewed"
        )
    }

    needs_review = {
        case_id
        for case_id, case in (
            cases.items()
        )
        if str(
            case.get("status")
            or ""
        ).lower() == "needs_review"
    }

    patterns: dict[
        tuple[str, str],
        dict[str, Any],
    ] = {}

    def add(
        *,
        family: str,
        name: str,
        case_id: int,
        scanners: set[str] | None = None,
        basis: str = "",
        example: str = "",
    ) -> None:
        if (
            not family
            or not name
            or case_id not in cases
        ):
            return

        key = (
            family,
            name,
        )

        record = patterns.setdefault(
            key,
            {
                "family": family,
                "name": name,
                "case_ids": set(),
                "repositories": set(),
                "case_scanners": defaultdict(
                    set
                ),
                "basis": set(),
                "examples": set(),
            },
        )

        record["case_ids"].add(
            case_id
        )

        record["repositories"].add(
            str(
                cases[case_id].get(
                    "repository"
                )
                or ""
            )
        )

        if scanners:
            record["case_scanners"][
                case_id
            ].update(scanners)

        if basis:
            record["basis"].add(
                basis
            )

        if example:
            record["examples"].add(
                example
            )

    for case_id, case in cases.items():
        repository_language = str(
            case.get(
                "repository_language"
            )
            or ""
        ).strip()

        if repository_language:
            add(
                family="Linguist context",
                name=(
                    "Repository language: "
                    + repository_language
                ),
                case_id=case_id,
                scanners=set(
                    case_routes.get(
                        case_id,
                        set(),
                    )
                ),
                basis=(
                    "Repository-level language "
                    "context"
                ),
            )

        cohort = str(
            case.get("ai_cohort")
            or ""
        ).strip()

        if cohort:
            add(
                family="AI indicator",
                name=(
                    "AI cohort: "
                    + cohort
                ),
                case_id=case_id,
                scanners=set(
                    case_routes.get(
                        case_id,
                        set(),
                    )
                ),
                basis=(
                    "Stored explicit AI "
                    "candidate cohort"
                ),
            )

    for (
        case_id,
        marker,
    ) in _ai_marker_rows(
        db,
        cases,
    ):
        add(
            family="AI indicator",
            name=marker,
            case_id=case_id,
            scanners=set(
                case_routes.get(
                    case_id,
                    set(),
                )
            ),
            basis=(
                "Explicit persisted AI "
                "indicator"
            ),
        )

    for artifact in artifacts:
        case_id = integer(
            artifact.get("case_id")
        )

        region = str(
            artifact.get("region")
            or "unknown"
        ).strip()

        language = str(
            artifact.get("language")
            or "Unknown language"
        ).strip()

        path = str(
            artifact.get("path")
            or ""
        ).strip()

        path_group = path_pattern(path)

        routes = parse_list(
            artifact.get(
                "scanner_routes"
            )
        )

        scanners = {
            ROUTE_TO_SCANNER[
                route
            ]
            for route in routes
            if route in ROUTE_TO_SCANNER
        }

        add(
            family="Region",
            name=region,
            case_id=case_id,
            scanners=scanners,
            basis=(
                "Persisted artifact-region "
                "mapping"
            ),
            example=path,
        )

        add(
            family="File fact",
            name=(
                "Language: "
                + language
            ),
            case_id=case_id,
            scanners=scanners,
            basis=(
                "Identify/Linguist-derived "
                "file language"
            ),
            example=path,
        )

        for identify_tag in (
            _extract_identify_tags(
                artifact.get("evidence")
            )
        ):
            add(
                family="File fact",
                name=(
                    "Identify: "
                    + identify_tag
                ),
                case_id=case_id,
                scanners=scanners,
                basis=(
                    "pre-commit Identify "
                    "file tag"
                ),
                example=path,
            )

        add(
            family="Path rule",
            name=path_group,
            case_id=case_id,
            scanners=scanners,
            basis=(
                "Changed-file path/name "
                "grouping"
            ),
            example=path,
        )

        for route in routes:
            scanner = (
                ROUTE_TO_SCANNER.get(
                    route
                )
            )

            add(
                family="Scanner route",
                name=route,
                case_id=case_id,
                scanners=(
                    {scanner}
                    if scanner
                    else set()
                ),
                basis=(
                    "Persisted region-to-"
                    "scanner route"
                ),
                example=path,
            )

        route_label = (
            " + ".join(routes)
            if routes
            else "manual inspection"
        )

        add(
            family="Mapping rule",
            name=(
                f"{language} + "
                f"{path_group} → "
                f"{region} → "
                f"{route_label}"
            ),
            case_id=case_id,
            scanners=scanners,
            basis=(
                "Combined file fact, path "
                "rule, region and route"
            ),
            example=path,
        )

        if "unknown" in region.lower():
            add(
                family="Unknown pattern",
                name=(
                    f"{language} + "
                    f"{path_group}"
                ),
                case_id=case_id,
                scanners=scanners,
                basis=(
                    "Recurring file-fact "
                    "combination in the "
                    "Unknown region"
                ),
                example=path,
            )

    result: list[
        dict[str, Any]
    ] = []

    for (
        family,
        name,
    ), raw in patterns.items():
        case_ids = set(
            raw["case_ids"]
        )

        repositories = {
            repository
            for repository in (
                raw["repositories"]
            )
            if repository
        }

        scanned_cases: set[int] = set()

        route_names: set[str] = set()

        for case_id in case_ids:
            scanners = set(
                raw["case_scanners"].get(
                    case_id,
                    set(),
                )
            )

            if not scanners:
                scanners = set(
                    case_routes.get(
                        case_id,
                        set(),
                    )
                )

            route_names.update(
                scanners
            )

            if (
                scanners
                and all(
                    terminal_status(
                        runs.get(
                            (
                                case_id,
                                scanner,
                            ),
                            {},
                        ).get(
                            "status"
                        )
                    )
                    for scanner in scanners
                )
            ):
                scanned_cases.add(
                    case_id
                )

        reviewed_cases = (
            case_ids & reviewed
        )

        case_count = len(case_ids)
        repository_count = len(
            repositories
        )

        result.append({
            "pattern_id": _pattern_id(
                family,
                name,
            ),
            "family": family,
            "name": name,
            "cases": case_count,
            "repositories": (
                repository_count
            ),
            "scanned": len(
                scanned_cases
            ),
            "reviewed": len(
                reviewed_cases
            ),
            "introduced": len(
                case_ids
                & introduced
            ),
            "security": len(
                case_ids
                & security
            ),
            "quality": len(
                case_ids
                & quality
            ),
            "manual_positive": len(
                case_ids
                & manual_positive
            ),
            "needs_review": len(
                case_ids
                & needs_review
            ),
            "coverage_pct": round(
                (
                    len(scanned_cases)
                    / case_count
                    * 100
                )
                if case_count
                else 0.0,
                2,
            ),
            "manual_coverage_pct": round(
                (
                    len(reviewed_cases)
                    / case_count
                    * 100
                )
                if case_count
                else 0.0,
                2,
            ),
            "introduced_yield_pct": round(
                (
                    len(
                        case_ids
                        & introduced
                    )
                    / len(scanned_cases)
                    * 100
                )
                if scanned_cases
                else 0.0,
                2,
            ),
            "security_yield_pct": round(
                (
                    len(
                        case_ids
                        & security
                    )
                    / len(scanned_cases)
                    * 100
                )
                if scanned_cases
                else 0.0,
                2,
            ),
            "quality_yield_pct": round(
                (
                    len(
                        case_ids
                        & quality
                    )
                    / len(scanned_cases)
                    * 100
                )
                if scanned_cases
                else 0.0,
                2,
            ),
            "manual_yield_pct": round(
                (
                    len(
                        case_ids
                        & manual_positive
                    )
                    / len(reviewed_cases)
                    * 100
                )
                if reviewed_cases
                else 0.0,
                2,
            ),
            "confidence": _confidence_label(
                case_count,
                repository_count,
            ),
            "scanners": sorted(
                route_names
            ),
            "basis": sorted(
                raw["basis"]
            )[:5],
            "examples": sorted(
                raw["examples"]
            )[:8],
            "case_ids": sorted(
                case_ids
            ),
        })

    return sorted(
        result,
        key=lambda row: (
            -integer(
                row.get("cases")
            ),
            str(
                row.get("family")
            ),
            str(
                row.get("name")
            ),
        ),
    )


def _chunks(
    values: list[int],
    size: int = 400,
) -> Iterable[list[int]]:
    for index in range(
        0,
        len(values),
        size,
    ):
        yield values[
            index:index + size
        ]


def case_rows_for_ids(
    db_path: str,
    case_ids: Iterable[int],
) -> list[dict[str, Any]]:
    ids = sorted({
        integer(value)
        for value in case_ids
        if integer(value)
    })

    if not ids:
        return []

    db = Database(
        Path(db_path)
    )

    rows: list[
        dict[str, Any]
    ] = []

    for chunk in _chunks(ids):
        placeholders = ",".join(
            "?"
            for _ in chunk
        )

        rows.extend(
            safe_query(
                db,
                f"""
                SELECT
                    c.id AS case_id,
                    r.full_name AS repository,
                    i.title AS issue_title,
                    c.status,
                    c.final_label,

                    COALESCE(
                        findings.finding_count,
                        0
                    ) AS finding_count,

                    COALESCE(
                        findings.introduced_count,
                        0
                    ) AS introduced_count,

                    COALESCE(
                        regions.region_list,
                        ''
                    ) AS regions

                FROM cases c

                JOIN repos r
                  ON r.id = c.repo_id

                JOIN issues i
                  ON i.id = c.issue_id

                LEFT JOIN (
                    SELECT
                        case_id,
                        COUNT(*) AS finding_count,
                        SUM(
                            CASE
                                WHEN COALESCE(
                                    introduced,
                                    0
                                ) = 1
                                THEN 1
                                ELSE 0
                            END
                        ) AS introduced_count
                    FROM scanner_findings
                    GROUP BY case_id
                ) findings
                  ON findings.case_id = c.id

                LEFT JOIN (
                    SELECT
                        case_id,
                        GROUP_CONCAT(
                            DISTINCT region
                        ) AS region_list
                    FROM artifact_regions
                    GROUP BY case_id
                ) regions
                  ON regions.case_id = c.id

                WHERE c.id IN (
                    {placeholders}
                )

                ORDER BY
                    introduced_count DESC,
                    finding_count DESC,
                    c.id
                """,
                chunk,
            )
        )

    return rows


def scanner_detail(
    db_path: str,
    scanner_value: str,
) -> dict[str, Any]:
    scanner = normalise_scanner(
        scanner_value
    )

    db = Database(
        Path(db_path)
    )

    live = load_live_overview(
        db_path
    )

    metric = next(
        (
            row
            for row in live["scanners"]
            if row["scanner"] == scanner
        ),
        {
            "scanner": scanner,
            "label": SCANNER_LABELS.get(
                scanner,
                scanner,
            ),
            "eligible": 0,
            "terminal": 0,
            "errors": 0,
            "findings": 0,
            "positive_cases": 0,
        },
    )

    eligible, _case_routes = (
        scanner_eligibility(db)
    )

    case_ids = sorted(
        eligible.get(
            scanner,
            set(),
        )
    )

    findings = [
        row
        for row in safe_query(
            db,
            """
            SELECT
                case_id,
                scanner,
                finding_type,
                severity,
                rule_id,
                cwe,
                file_path,
                description,
                evidence,
                raw_json,
                introduced
            FROM scanner_findings
            """,
        )
        if normalise_scanner(
            row.get("scanner")
        ) == scanner
    ]

    cases = _case_metadata(db)

    artifact_rows = safe_query(
        db,
        """
        SELECT
            case_id,
            path,
            region,
            language
        FROM artifact_regions
        """,
    )

    path_regions: dict[
        tuple[int, str],
        str,
    ] = {}

    case_regions: dict[
        int,
        set[str],
    ] = defaultdict(set)

    for row in artifact_rows:
        case_id = integer(
            row.get("case_id")
        )

        region = str(
            row.get("region")
            or "Unknown"
        )

        path_regions[
            (
                case_id,
                normalise_path(
                    row.get("path")
                ),
            )
        ] = region

        case_regions[
            case_id
        ].add(region)

    rule_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    severity_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    type_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    region_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    path_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    repository_counts: dict[
        str,
        int,
    ] = defaultdict(int)

    for finding in findings:
        case_id = integer(
            finding.get("case_id")
        )

        rule = str(
            finding.get("rule_id")
            or finding.get(
                "finding_type"
            )
            or "Unclassified"
        )

        severity = str(
            finding.get("severity")
            or "Unspecified"
        )

        finding_type = str(
            finding.get(
                "finding_type"
            )
            or "Unclassified"
        )

        file_path = normalise_path(
            finding.get("file_path")
        )

        rule_counts[rule] += 1
        severity_counts[
            severity
        ] += 1
        type_counts[
            finding_type
        ] += 1

        path_counts[
            path_pattern(file_path)
        ] += 1

        region = path_regions.get(
            (
                case_id,
                file_path,
            )
        )

        if region:
            region_counts[
                region
            ] += 1
        else:
            for case_region in (
                case_regions.get(
                    case_id,
                    {"Unknown"},
                )
            ):
                region_counts[
                    case_region
                ] += 1

        repository = str(
            cases.get(
                case_id,
                {},
            ).get(
                "repository"
            )
            or "Unknown"
        )

        repository_counts[
            repository
        ] += 1

    return {
        "scanner": scanner,
        "label": SCANNER_LABELS.get(
            scanner,
            scanner,
        ),
        "metric": metric,
        "case_ids": case_ids,
        # Scanner Insights performs SQL pagination.
        # Do not materialise every applicable case here.
        "case_rows": [],
        "rules": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                rule_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )[:20]
        ],
        "severities": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                severity_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )
        ],
        "types": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                type_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )[:20]
        ],
        "regions": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                region_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )
        ],
        "path_patterns": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                path_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )
        ],
        "repositories": [
            {
                "name": name,
                "value": value,
            }
            for name, value in sorted(
                repository_counts.items(),
                key=lambda item: (
                    -item[1],
                    item[0],
                ),
            )[:20]
        ],
    }


def latest_scanner_raw(
    db_path: str,
    case_id: int,
    scanner_value: str,
) -> dict[str, Any]:
    scanner = normalise_scanner(
        scanner_value
    )

    db = Database(
        Path(db_path)
    )

    rows = safe_query(
        db,
        """
        SELECT
            id,
            case_id,
            scanner,
            status,
            started_at,
            finished_at,
            stdout,
            stderr
        FROM scanner_runs
        WHERE case_id=?
        ORDER BY id DESC
        """,
        (
            int(case_id),
        ),
    )

    for row in rows:
        if normalise_scanner(
            row.get("scanner")
        ) == scanner:
            return row

    return {}


def pattern_breakdown(
    db_path: str,
    case_ids: Iterable[int],
) -> dict[str, list[dict[str, Any]]]:
    ids = sorted({
        integer(value)
        for value in case_ids
        if integer(value)
    })

    if not ids:
        return {
            "regions": [],
            "scanners": [],
            "languages": [],
            "paths": [],
        }

    db = Database(
        Path(db_path)
    )

    region_counts: dict[
        str,
        set[int],
    ] = defaultdict(set)

    language_counts: dict[
        str,
        set[int],
    ] = defaultdict(set)

    path_counts: dict[
        str,
        set[int],
    ] = defaultdict(set)

    scanner_counts: dict[
        str,
        set[int],
    ] = defaultdict(set)

    id_set = set(ids)

    for row in safe_query(
        db,
        """
        SELECT
            case_id,
            path,
            region,
            language,
            scanner_routes
        FROM artifact_regions
        """,
    ):
        case_id = integer(
            row.get("case_id")
        )

        if case_id not in id_set:
            continue

        region_counts[
            str(
                row.get("region")
                or "Unknown"
            )
        ].add(case_id)

        language_counts[
            str(
                row.get("language")
                or "Unknown"
            )
        ].add(case_id)

        path_counts[
            path_pattern(
                row.get("path")
            )
        ].add(case_id)

        for route in parse_list(
            row.get("scanner_routes")
        ):
            scanner = ROUTE_TO_SCANNER.get(
                route
            )

            if scanner:
                scanner_counts[
                    SCANNER_LABELS.get(
                        scanner,
                        scanner,
                    )
                ].add(case_id)

    def rows(
        mapping: dict[
            str,
            set[int],
        ],
    ) -> list[dict[str, Any]]:
        return [
            {
                "name": name,
                "value": len(values),
            }
            for name, values in sorted(
                mapping.items(),
                key=lambda item: (
                    -len(item[1]),
                    item[0],
                ),
            )
        ]

    return {
        "regions": rows(
            region_counts
        ),
        "scanners": rows(
            scanner_counts
        ),
        "languages": rows(
            language_counts
        ),
        "paths": rows(
            path_counts
        ),
    }


def fetch_case_page(
    db_path: str,
    *,
    search: str,
    stage: str,
    region: str,
    repository: str,
    sort: str,
    page: int,
    page_size: int = 40,
) -> tuple[int, list[dict[str, Any]]]:
    db = Database(
        Path(db_path)
    )

    conditions: list[str] = []
    parameters: list[Any] = []

    search = search.strip()

    if search:
        value = (
            "%"
            + search.lower()
            + "%"
        )

        conditions.append(
            """
            (
                LOWER(
                    CAST(c.id AS TEXT)
                ) LIKE ?
                OR LOWER(
                    r.full_name
                ) LIKE ?
                OR LOWER(
                    COALESCE(
                        i.title,
                        ''
                    )
                ) LIKE ?
            )
            """
        )

        parameters.extend(
            [
                value,
                value,
                value,
            ]
        )

    stage_conditions = {
        "Needs review": (
            "c.status='needs_review'"
        ),
        "Reviewed": (
            "("
            "c.status='reviewed' "
            "OR COALESCE("
            "TRIM(c.final_label),'')<>''"
            ")"
        ),
        "Positive evidence": (
            "EXISTS ("
            "SELECT 1 "
            "FROM scanner_findings sf "
            "WHERE sf.case_id=c.id "
            "AND COALESCE("
            "sf.introduced,0)=1"
            ")"
        ),
        "Problems": (
            "EXISTS ("
            "SELECT 1 "
            "FROM scanner_runs sr "
            "WHERE sr.case_id=c.id "
            "AND ("
            "LOWER(sr.status) LIKE '%error%' "
            "OR LOWER(sr.status) LIKE '%fail%' "
            "OR LOWER(sr.status) LIKE '%timeout%'"
            ")"
            ")"
        ),
        "In progress": (
            "c.status IN ("
            "'metadata_collected',"
            "'validated',"
            "'scanner_running',"
            "'scan_blocked',"
            "'scanner_blocked'"
            ")"
        ),
    }

    if stage in stage_conditions:
        conditions.append(
            stage_conditions[stage]
        )

    if region != "All":
        conditions.append(
            """
            EXISTS (
                SELECT 1
                FROM artifact_regions ar
                WHERE ar.case_id=c.id
                  AND ar.region=?
            )
            """
        )

        parameters.append(region)

    if repository != "All":
        conditions.append(
            "r.full_name=?"
        )

        parameters.append(
            repository
        )

    where_sql = (
        "WHERE "
        + " AND ".join(
            conditions
        )
        if conditions
        else ""
    )

    total = integer(
        safe_one(
            db,
            f"""
            SELECT
                COUNT(*) AS n
            FROM cases c
            JOIN repos r
              ON r.id=c.repo_id
            JOIN issues i
              ON i.id=c.issue_id
            {where_sql}
            """,
            parameters,
        ).get("n")
    )

    order_options = {
        "Priority": """
            CASE
                WHEN c.status='needs_review'
                THEN 0
                WHEN EXISTS (
                    SELECT 1
                    FROM scanner_findings sf
                    WHERE sf.case_id=c.id
                      AND COALESCE(
                            sf.introduced,
                            0
                          )=1
                )
                THEN 1
                ELSE 2
            END,
            introduced_count DESC,
            finding_count DESC,
            c.updated_at DESC,
            c.id DESC
        """,
        "Newest": """
            c.updated_at DESC,
            c.id DESC
        """,
        "Oldest": """
            c.updated_at ASC,
            c.id ASC
        """,
        "Repository": """
            r.full_name ASC,
            c.id DESC
        """,
        "Case ID": """
            c.id ASC
        """,
    }

    order_sql = order_options.get(
        sort,
        order_options["Priority"],
    )

    offset = (
        max(
            1,
            int(page),
        )
        - 1
    ) * int(page_size)

    page_parameters = [
        *parameters,
        int(page_size),
        offset,
    ]

    rows = safe_query(
        db,
        f"""
        SELECT
            c.id AS case_id,
            r.full_name AS repository,

            SUBSTR(
                COALESCE(
                    i.title,
                    ''
                ),
                1,
                110
            ) AS issue_title,

            c.status,
            c.final_label,

            COALESCE(
                findings.finding_count,
                0
            ) AS finding_count,

            COALESCE(
                findings.introduced_count,
                0
            ) AS introduced_count,

            COALESCE(
                regions.region_list,
                ''
            ) AS regions

        FROM cases c

        JOIN repos r
          ON r.id=c.repo_id

        JOIN issues i
          ON i.id=c.issue_id

        LEFT JOIN (
            SELECT
                case_id,
                COUNT(*) AS finding_count,
                SUM(
                    CASE
                        WHEN COALESCE(
                            introduced,
                            0
                        )=1
                        THEN 1
                        ELSE 0
                    END
                ) AS introduced_count
            FROM scanner_findings
            GROUP BY case_id
        ) findings
          ON findings.case_id=c.id

        LEFT JOIN (
            SELECT
                case_id,
                GROUP_CONCAT(
                    DISTINCT region
                ) AS region_list
            FROM artifact_regions
            GROUP BY case_id
        ) regions
          ON regions.case_id=c.id

        {where_sql}

        ORDER BY
            {order_sql}

        LIMIT ?
        OFFSET ?
        """,
        page_parameters,
    )

    return total, rows


def filter_options(
    db_path: str,
) -> dict[str, list[str]]:
    db = Database(
        Path(db_path)
    )

    repositories = [
        str(row.get("full_name"))
        for row in safe_query(
            db,
            """
            SELECT full_name
            FROM repos
            ORDER BY full_name
            """,
        )
        if row.get("full_name")
    ]

    regions = [
        str(row.get("region"))
        for row in safe_query(
            db,
            """
            SELECT DISTINCT region
            FROM artifact_regions
            WHERE COALESCE(
                TRIM(region),
                ''
            )<>''
            ORDER BY region
            """,
        )
        if row.get("region")
    ]

    return {
        "repositories": repositories,
        "regions": regions,
    }
