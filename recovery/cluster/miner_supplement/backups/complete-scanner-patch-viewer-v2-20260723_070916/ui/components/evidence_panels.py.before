from __future__ import annotations

import json
from collections import Counter

import pandas as pd
import streamlit as st

from ui.components.badges import badge_row, json_tags
from ui.utils.rendering import render_diff, safe_markdown


def upstream_badges(row: dict) -> list[str]:
    badges = []
    if (row.get("issue_word_count") or 0) >= 150:
        badges.append("Long issue")
    if row.get("has_code_block") or row.get("has_inline_code"):
        badges.append("Code/reproduction artifact")
    if row.get("has_traceback_or_log"):
        badges.append("Traceback/log")
    if row.get("has_file_path") or row.get("has_function_or_class"):
        badges.append("File/function mention")
    if row.get("has_suggested_fix"):
        badges.append("Suggested fix")
    if row.get("has_dependency_or_version"):
        badges.append("Dependency/version mention")
    if row.get("has_ai_marker"):
        badges.append("AI marker")
    return badges


def _link_button(label: str, url: str | None) -> None:
    if url:
        st.link_button(label, url, width="stretch")


def render_upstream_panel(row: dict) -> None:
    title = row.get("issue_title") or "Untitled issue"
    url = row.get("issue_url")
    if url:
        st.markdown(f"### [Issue: {title}]({url})")
    else:
        st.markdown(f"### Issue: {title}")
    meta = []
    if row.get("issue_author"):
        meta.append(f"by `{row.get('issue_author')}`")
    if row.get("issue_created_at"):
        meta.append(f"created {row.get('issue_created_at')}")
    if row.get("issue_comments_count") is not None:
        meta.append(f"{row.get('issue_comments_count')} comments")
    if meta:
        st.caption(" · ".join(meta))
    badges = upstream_badges(row)
    try:
        feature_json = json.loads(row.get("feature_json") or "{}")
    except Exception:
        feature_json = {}
    rich_badges = []
    for key, label in (
        ("has_reproduction_steps", "Reproduction steps"),
        ("has_expected_actual", "Expected/actual"),
        ("has_failing_test_signal", "Failing test"),
        ("has_security_steering_signal", "Security wording"),
        ("has_ci_or_secret_steering_signal", "CI/secrets wording"),
        ("has_ai_text_signal", "AI text mention"),
    ):
        if feature_json.get(key):
            rich_badges.append(label)
    badge_row(badges + rich_badges)
    if feature_json:
        with st.expander("Upstream indicators", expanded=False):
            st.json(feature_json)
    st.markdown('<div class="evidence-card">', unsafe_allow_html=True)
    safe_markdown(row.get("issue_body"), max_chars=40000)
    st.markdown('</div>', unsafe_allow_html=True)

    if row.get("pr_body"):
        with st.expander("PR description", expanded=False):
            safe_markdown(row.get("pr_body"), max_chars=18000)


def _pretty_json(value: str | None) -> str:
    if not value:
        return ""
    try:
        return json.dumps(json.loads(value), indent=2, ensure_ascii=False)
    except Exception:
        return str(value)


def _finding_label(f: dict) -> str:
    signal = str(f.get("finding_type") or "finding").replace("_", " ").title()
    scanner = str(f.get("scanner") or "scanner")
    rule = f.get("rule_id") or f.get("cwe") or ""
    loc = f.get("file_path") or ""
    if f.get("line"):
        loc += f":{f.get('line')}"
    return " · ".join(x for x in (signal, scanner, rule, loc) if x)



def _status_badge_text(status: str | None) -> str:
    value = str(status or "unknown")
    icons = {
        "ok": "✅",
        "finding": "🚩",
        "not_applicable": "⚪",
        "pending": "⏳",
        "retry": "🔁",
        "running": "🟦",
        "partial": "⚠️",
        "error": "❌",
        "timeout": "⏱️",
    }
    return f"{icons.get(value, '•')} {value}"


def _inline_integer(value) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _inline_json_value(value):
    if isinstance(value, (dict, list)):
        return value

    if value in (None, ""):
        return {}

    text = str(value).strip()

    if not text:
        return {}

    try:
        return json.loads(text)
    except Exception:
        return value


def _inline_json_dict(value) -> dict:
    parsed = _inline_json_value(value)

    if isinstance(parsed, dict):
        return parsed

    return {}


def _inline_scanner_name(value) -> str:
    scanner = (
        str(value or "")
        .strip()
        .lower()
        .replace("_", "-")
    )

    aliases = {
        "codeql-security": "codeql",
        "semgrep-source": "semgrep",
        "secret-ci": "gitleaks",
        "dependency-downgrade":
            "dependency-diff",
        "osv": "osv-scanner",
        "trivy-scanner": "trivy",
    }

    return aliases.get(
        scanner,
        scanner,
    )


def _inline_scanner_label(value) -> str:
    scanner = _inline_scanner_name(
        value
    )

    return {
        "codeql": "CodeQL",
        "semgrep": "Semgrep",
        "gitleaks": "Gitleaks",
        "dependency-diff":
            "Dependency diff",
        "osv-scanner": "OSV",
        "trivy": "Trivy",
    }.get(
        scanner,
        scanner or "Unknown",
    )


def _normalise_inline_finding(
    finding: dict,
) -> dict:
    output = dict(finding)

    scanner = _inline_scanner_name(
        finding.get("scanner")
    )

    raw = _inline_json_dict(
        finding.get("raw_json")
    )

    evidence_value = _inline_json_value(
        finding.get("evidence")
    )

    evidence = (
        evidence_value
        if isinstance(
            evidence_value,
            dict,
        )
        else {}
    )

    file_path = str(
        finding.get("file_path")
        or ""
    ).strip()

    start_line = _inline_integer(
        finding.get("line")
    )

    end_line = start_line
    start_column = 0
    end_column = 0

    if scanner == "codeql":
        locations = (
            raw.get("locations")
            or []
        )

        if locations:
            primary = locations[0] or {}

            physical = (
                primary.get(
                    "physicalLocation"
                )
                or {}
            )

            artifact = (
                physical.get(
                    "artifactLocation"
                )
                or {}
            )

            region = (
                physical.get("region")
                or {}
            )

            file_path = (
                file_path
                or str(
                    artifact.get("uri")
                    or ""
                )
            )

            start_line = (
                start_line
                or _inline_integer(
                    region.get(
                        "startLine"
                    )
                )
            )

            end_line = (
                _inline_integer(
                    region.get("endLine")
                )
                or start_line
            )

            start_column = (
                _inline_integer(
                    region.get(
                        "startColumn"
                    )
                )
            )

            end_column = (
                _inline_integer(
                    region.get(
                        "endColumn"
                    )
                )
            )

    elif scanner == "semgrep":
        start = raw.get("start") or {}
        end = raw.get("end") or {}

        file_path = (
            file_path
            or str(
                raw.get("path")
                or ""
            )
        )

        start_line = (
            start_line
            or _inline_integer(
                start.get("line")
            )
        )

        end_line = (
            _inline_integer(
                end.get("line")
            )
            or start_line
        )

        start_column = (
            _inline_integer(
                start.get("col")
            )
        )

        end_column = (
            _inline_integer(
                end.get("col")
            )
        )

    elif scanner == "gitleaks":
        file_path = (
            file_path
            or str(
                raw.get("File")
                or ""
            )
        )

        start_line = (
            start_line
            or _inline_integer(
                raw.get("StartLine")
            )
        )

        end_line = (
            _inline_integer(
                raw.get("EndLine")
            )
            or start_line
        )

        start_column = (
            _inline_integer(
                raw.get("StartColumn")
            )
        )

        end_column = (
            _inline_integer(
                raw.get("EndColumn")
            )
        )

    elif scanner == "dependency-diff":
        file_path = (
            file_path
            or str(
                raw.get("file")
                or ""
            )
        )

        start_line = (
            start_line
            or _inline_integer(
                raw.get("line")
            )
        )

        end_line = start_line

    package = str(
        evidence.get("package")
        or ""
    )

    version = str(
        evidence.get("version")
        or evidence.get(
            "new_version"
        )
        or ""
    )

    old_version = str(
        evidence.get("old_version")
        or ""
    )

    fixed_version = str(
        evidence.get("fixed_version")
        or ""
    )

    identifier = str(
        finding.get("rule_id")
        or evidence.get("vuln_id")
        or evidence.get(
            "vulnerability"
        )
        or evidence.get(
            "change_type"
        )
        or finding.get(
            "finding_type"
        )
        or "finding"
    )

    context_parts = []

    for name in (
        "confidence",
        "impact",
        "likelihood",
    ):
        value = evidence.get(name)

        if value not in (
            None,
            "",
        ):
            context_parts.append(
                name + "=" + str(value)
            )

    if "promoted" in evidence:
        context_parts.append(
            "promoted="
            + str(
                bool(
                    evidence.get(
                        "promoted"
                    )
                )
            ).lower()
        )

    rejection_reasons = (
        evidence.get(
            "rejection_reasons"
        )
        or []
    )

    if rejection_reasons:
        context_parts.append(
            "rejection="
            + ", ".join(
                str(reason)
                for reason
                in rejection_reasons
            )
        )

    location_kind = (
        "Exact scanner line"
        if start_line > 0
        else (
            "Package/file level"
            if scanner in {
                "osv-scanner",
                "trivy",
            }
            or package
            else "File level"
        )
    )

    location_label = (
        file_path
        or "Unknown file"
    )

    if start_line > 0:
        location_label += (
            ":" + str(start_line)
        )

        if (
            end_line
            and end_line != start_line
        ):
            location_label += (
                "-" + str(end_line)
            )

        if start_column:
            location_label += (
                ":" + str(start_column)
            )

            if end_column:
                location_label += (
                    "-" + str(end_column)
                )

    introduced = _inline_integer(
        finding.get("introduced")
    )

    introduction_label = (
        "Scanner delta marked introduced"
        if introduced == 1
        else "Stored finding; not marked introduced"
    )

    output.update({
        "scanner":
            scanner,
        "scanner_label":
            _inline_scanner_label(
                scanner
            ),
        "file_path":
            file_path,
        "line":
            start_line,
        "start_line":
            start_line,
        "end_line":
            end_line or start_line,
        "start_column":
            start_column,
        "end_column":
            end_column,
        "identifier":
            identifier,
        "package":
            package,
        "version":
            version,
        "old_version":
            old_version,
        "fixed_version":
            fixed_version,
        "location_kind":
            location_kind,
        "location_label":
            location_label,
        "introduction_label":
            introduction_label,
        "triage_context":
            " · ".join(
                context_parts
            ),
        "evidence_parsed":
            evidence_value,
        "raw_parsed":
            raw,
    })

    return output

def render_downstream_panel(row: dict, files: list[dict], findings: list[dict], scanner_runs: list[dict] | None = None, scanner_jobs: list[dict] | None = None) -> None:
    findings = [
        _normalise_inline_finding(finding)
        for finding in findings
    ]

    title = row.get("pr_title") or "Untitled PR"
    url = row.get("pr_url")
    if url:
        st.markdown(f"### [PR: {title}]({url})")
    else:
        st.markdown(f"### PR: {title}")
    st.caption(f"State: {row.get('pr_state')} · Merged: {bool(row.get('pr_merged'))} · Author: {row.get('pr_author') or 'unknown'}")

    st.markdown("#### Worker routing")
    if scanner_jobs:
        job_rows = []
        for job in scanner_jobs:
            job_rows.append({
                "Worker": job.get("job_type"),
                "Job status": _status_badge_text(job.get("status")),
                "Why it ran / not applicable": job.get("route_reason") or "scheduled",
                "Last error": job.get("last_error") or "",
            })
        st.dataframe(pd.DataFrame(job_rows), hide_index=True, width="stretch")
    else:
        st.caption("No scanner jobs stored yet.")

    st.markdown("#### Scanner results")
    if scanner_runs:
        run_rows = []
        counts = Counter((f.get("scanner") or "unknown") for f in findings)
        for run in scanner_runs:
            run_rows.append({
                "Scanner": run.get("scanner"),
                "Status": run.get("status"),
                "Findings": counts.get(run.get("scanner"), 0),
                "Linked to diff": "yes" if counts.get(run.get("scanner"), 0) else "-",
            })
        st.dataframe(pd.DataFrame(run_rows), hide_index=True, width="stretch")
    elif findings:
        rows = []
        for scanner, count in Counter((f.get("scanner") or "unknown") for f in findings).items():
            rows.append({"Scanner": scanner, "Status": "finding stored", "Findings": count, "Linked to diff": "yes"})
        st.dataframe(pd.DataFrame(rows), hide_index=True, width="stretch")
    else:
        st.info("No stored scanner findings exist for this case.")

    if findings:
        st.markdown(
            "#### Scanner finding locations"
        )

        st.caption(
            "Exact-line findings are attached to the "
            "corresponding head line in the diff below. "
            "OSV and Trivy results remain package/file "
            "level when their output does not contain an "
            "authoritative source line."
        )

        location_rows = []

        for finding in findings:
            location_rows.append({
                "Scanner":
                    finding.get(
                        "scanner_label"
                    ),
                "Severity":
                    finding.get(
                        "severity"
                    )
                    or "Unranked",
                "Rule / CVE / GHSA":
                    finding.get(
                        "identifier"
                    ),
                "Location":
                    finding.get(
                        "location_label"
                    ),
                "Location type":
                    finding.get(
                        "location_kind"
                    ),
                "Introduction":
                    finding.get(
                        "introduction_label"
                    ),
                "Package":
                    finding.get(
                        "package"
                    ),
                "Old version":
                    finding.get(
                        "old_version"
                    ),
                "Current version":
                    finding.get(
                        "version"
                    ),
                "Fixed version":
                    finding.get(
                        "fixed_version"
                    ),
                "Scanner context":
                    finding.get(
                        "triage_context"
                    ),
                "Description":
                    finding.get(
                        "description"
                    ),
            })

        st.dataframe(
            location_rows,
            hide_index=True,
            width="stretch",
        )

        with st.expander("Finding cards", expanded=False):
            for f in findings:
                with st.container(border=True):
                    st.markdown(f"**{_finding_label(f)}**")
                    if f.get("description"):
                        st.write(f.get("description"))
                    if f.get("evidence"):
                        st.code(str(f.get("evidence"))[:3000])
                    raw = _pretty_json(f.get("raw_json"))
                    if raw:
                        with st.expander("Raw scanner JSON", expanded=False):
                            st.code(raw[:10000], language="json")

    st.markdown("#### Changed files")
    if files:
        lightweight = [{k: f.get(k) for k in ("filename", "category", "status", "additions", "deletions")} for f in files]
        st.dataframe(lightweight, width="stretch", hide_index=True)
    else:
        st.info("No changed files stored.")

    st.markdown("#### Annotated PR diff")

    st.caption(
        "Inline badges are shown only when a scanner "
        "reported an exact line. Package-level findings "
        "remain in the location table rather than being "
        "placed on an invented lockfile line."
    )
    shown = 0
    for f in files:
        patch = f.get("patch") or ""
        if not patch:
            continue
        filename = f.get("filename") or "file"
        file_findings = [x for x in findings if not x.get("file_path") or x.get("file_path") == filename or str(x.get("file_path")).endswith(filename) or filename.endswith(str(x.get("file_path")))]
        suffix = f" · {len(file_findings)} finding(s)" if file_findings else ""
        with st.expander(f"{filename}{suffix}", expanded=bool(file_findings) or shown < 2):
            render_diff(patch, max_lines=520, file_path=filename, findings=file_findings)
        shown += 1
        if shown >= 14:
            st.caption("Showing first 14 patch snippets. Export case for full patch evidence.")
            break


def _manage_tags_modal(db) -> None:
    all_tags = db.query("SELECT id, name FROM tags WHERE type='manual' ORDER BY name")
    st.caption("Rename, delete, or add manual tags used across all cases.")
    if not all_tags:
        st.info("No global manual tags yet.")
    for t in all_tags:
        c1, c2, c3 = st.columns([4, 1, 1], gap="small")
        new_name = c1.text_input("Tag name", value=t["name"], key=f"rename_tag_{t['id']}", label_visibility="collapsed")
        if c2.button("Rename", key=f"rename_btn_{t['id']}", width="stretch") and new_name.strip():
            db.execute("UPDATE tags SET name=? WHERE id=?", (new_name.strip(), t["id"]))
            st.rerun()
        if c3.button("Delete", key=f"delete_tag_{t['id']}", width="stretch"):
            db.execute("DELETE FROM case_tags WHERE tag_id=?", (t["id"],))
            db.execute("DELETE FROM tags WHERE id=?", (t["id"],))
            st.rerun()
    st.divider()
    c_add1, c_add2 = st.columns([4, 1], gap="small")
    new_tag = c_add1.text_input("New global tag", key="new_global_tag", placeholder="e.g. needs-codeql")
    if c_add2.button("Add", width="stretch") and new_tag.strip():
        db.execute("INSERT OR IGNORE INTO tags(name, type) VALUES (?, 'manual')", (new_tag.strip(),))
        st.rerun()


if hasattr(st, "dialog"):
    @st.dialog("Manage global tags")
    def _manage_tags_dialog(db) -> None:
        _manage_tags_modal(db)
else:
    _manage_tags_dialog = None


def render_review_panel(row: dict, db, case_id: int | None = None) -> None:
    case_id = int(case_id or row["case_id"])
    st.markdown(
        """
<div class='decision-shell'>
  <div class='decision-title'>Decision</div>
  <div class='decision-help'>Assign your manual label, optional tags, and notes for this case.</div>
</div>
""",
        unsafe_allow_html=True,
    )

    labels = [
        "Benign",
        "Tool false positive",
        "Benign security fix",
        "Security regression candidate",
        "Suspicious issue-linked regression",
        "High-confidence suspicious",
        "Unclear",
    ]
    current = row.get("final_label") or "Unclear"
    final = st.radio(
        "Manual label",
        labels,
        index=labels.index(current) if current in labels else labels.index("Unclear"),
        horizontal=False,
        help="Your final human judgement for this case.",
    )

    all_tags = db.query("SELECT id, name FROM tags WHERE type='manual' ORDER BY name")
    case_tags = db.query("SELECT t.id, t.name FROM case_tags ct JOIN tags t ON ct.tag_id=t.id WHERE ct.case_id=? ORDER BY t.name", (case_id,))
    current_tags = {t["name"] for t in case_tags}
    tag_names = [t["name"] for t in all_tags]

    c_tags, c_manage = st.columns([4, 1.35], gap="small", vertical_alignment="bottom")
    with c_tags:
        selected_tags = st.multiselect(
            "Case tags",
            options=tag_names,
            default=sorted(current_tags),
            help="Manual research tags assigned to this case.",
        )
    with c_manage:
        if st.button("Manage global tags", width="stretch"):
            if _manage_tags_dialog is not None:
                _manage_tags_dialog(db)
            else:
                st.session_state["show_global_tag_manager"] = not st.session_state.get("show_global_tag_manager", False)

    if _manage_tags_dialog is None and st.session_state.get("show_global_tag_manager"):
        with st.container(border=True):
            _manage_tags_modal(db)

    auto = json_tags(row.get("auto_tags"))
    if auto:
        with st.expander("Auto tags", expanded=False):
            badge_row(auto)

    notes = st.text_area(
        "Reviewer notes",
        row.get("review_notes") or "",
        height=180,
        placeholder="Briefly explain why the case is benign, unclear, suspicious, or a tool false positive.",
    )
    missing = st.text_area(
        "Missing evidence / follow-up",
        "",
        height=90,
        placeholder="Optional: what would make this case clearer?",
    )

    c1, c2 = st.columns([1, 1], gap="small")
    if c1.button("Save", type="primary", width="stretch"):
        _save_review(db, case_id, final, notes, selected_tags, all_tags)
        st.success("Review saved")
        st.rerun()
    if c2.button("Save & next", width="stretch"):
        _save_review(db, case_id, final, notes, selected_tags, all_tags)
        st.session_state["advance_after_save"] = True
        st.success("Review saved")
        st.rerun()

def _ensure_tag(db, case_id: int, tag_name: str) -> None:
    db.execute("INSERT OR IGNORE INTO tags(name, type) VALUES (?, 'manual')", (tag_name,))
    tag = db.one("SELECT id FROM tags WHERE name=?", (tag_name,))
    if tag:
        db.execute("INSERT OR IGNORE INTO case_tags(case_id, tag_id) VALUES (?, ?)", (case_id, tag["id"]))


def _save_review(db, case_id: int, final: str, notes: str, selected_tags: list[str], all_tags: list[dict]) -> None:
    db.execute("UPDATE cases SET final_label=?, review_notes=?, status='reviewed', updated_at=CURRENT_TIMESTAMP WHERE id=?", (final, notes, case_id))
    db.execute("DELETE FROM case_tags WHERE case_id=?", (case_id,))
    lookup = {t["name"]: t["id"] for t in all_tags}
    for name in selected_tags:
        tag_id = lookup.get(name)
        if tag_id:
            db.execute("INSERT OR IGNORE INTO case_tags(case_id, tag_id) VALUES (?, ?)", (case_id, tag_id))
