#!/bin/bash
#SBATCH --job-name=p3arm_eval
#SBATCH --partition=biggpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --time=02:00:00
#SBATCH --output=/home-mscluster/astrauss/research_artifacts/prevention_pilot_phase2/p3arm_eval_%j.out
#SBATCH --error=/home-mscluster/astrauss/research_artifacts/prevention_pilot_phase2/p3arm_eval_%j.err
set -euo pipefail
export PATH="$HOME/tools/node/bin:$HOME/.bun/bin:$HOME/tools/bun/bin:$PATH"
python3 - <<'PY'
import base64,hashlib,json,os,pathlib,re,subprocess,zlib
ROOT=pathlib.Path.home()/'research_artifacts'/'prevention_pilot_phase2'
JOB=os.environ['SLURM_JOB_ID']
OUT=ROOT/('pilot3_arms_job'+JOB)
OUT.mkdir(parents=True,exist_ok=False)
PATCHES={"OP":"","OW":""}
EXPECTED={'OP':'5283904055bac85a5b5e886b0e8d73d6a03729b893eca4d2069762865170b3ee','OW':'26688428041def4104a85322109bf084e283ac411304bf38613f37a07b5a2864'}
SCAN=(ROOT/'pilot3_evaluate_3patches_20261017_v2_nodefix.sbatch').read_text()
FUNC=(ROOT/'pilot3_functional_v1.sbatch').read_text()
needle="patchmap=ast.literal_eval(line.partition('=')[2]);patch=zlib.decompress(base64.b64decode(patchmap[str(rank)]))"
assert FUNC.count(needle)==1
oldsha='0e013e16a4c8f772ae404fddfbb0faad100ed13e041ecf7ab594e6b4a01bca4b'
assert FUNC.count(oldsha)==1
summary={}
for ARM in ('OP','OW'):
 armout=OUT/ARM
 armout.mkdir(exist_ok=False)
 compressed=PATCHES[ARM]
 patch=zlib.decompress(base64.b64decode(compressed))
 assert hashlib.sha256(patch).hexdigest()==EXPECTED[ARM],'Patch checksum mismatch'
 (armout/'candidate.patch').write_bytes(patch)
 scan,n=re.subn(r'(?m)^PATCHES=.*$',lambda m:'PATCHES='+repr({'8':compressed}),SCAN)
 assert n==1
 scan=scan.replace('pilot3_scan_fix_job','pilot3_arms_scan_job')
 scan=scan.replace('pilot3_scan_fix_%A_%a','pilot3_arms_scan_%A_%a')
 func=FUNC.replace(oldsha,EXPECTED[ARM])
 func=func.replace(needle,"patch=(ROOT/('pilot3_arms_job'+os.environ['PILOT3_JOB_ROOT'])/os.environ['PILOT3_ARM']/'candidate.patch').read_bytes()")
 func=func.replace('pilot3_functional_job','pilot3_arms_functional_job')
 func=func.replace('pilot3_functional_%A_%a','pilot3_arms_functional_%A_%a')
 env=os.environ.copy()
 env.update(SLURM_ARRAY_TASK_ID='0',SLURM_ARRAY_JOB_ID=JOB+'_'+ARM,PILOT3_TASK='0',PILOT3_JOB=JOB+'_'+ARM,PILOT3_JOB_ROOT=JOB,PILOT3_ARM=ARM)
 stage=pathlib.Path(os.environ.get('SLURM_TMPDIR') or '/tmp')/('p3arm_stage_'+JOB+'_'+ARM)
 stage.mkdir(parents=True,exist_ok=False)
 summary[ARM]={}
 for label,content in (('scan',scan),('functional',func)):
  path=stage/(label+'.sh')
  path.write_text(content)
  print('RUN',ARM,label,'checksum',EXPECTED[ARM],flush=True)
  with (armout/(label+'.log')).open('x') as logfile:
   p=subprocess.run(['bash',str(path)],env=env,stdout=logfile,stderr=subprocess.STDOUT,timeout=5400)
  print('DONE',ARM,label,p.returncode,flush=True)
  report_path=ROOT/(('pilot3_arms_scan_job' if label=='scan' else 'pilot3_arms_functional_job')+JOB+'_'+ARM)/'rank_8'/'RESULT.json'
  report=json.loads(report_path.read_text()) if report_path.exists() else {}
  keys=('status','functionality','functional_correctness','base_alerts','patched_alerts','new_target_alerts','changed_line_attributed','target_reproduced','patch_sha256','reason')
  summary[ARM][label]={'exit':p.returncode,**{k:report.get(k) for k in keys}}
  (OUT/'SUMMARY.json').write_text(json.dumps(summary,indent=2)+'\n')
print('SUMMARY',json.dumps(summary),flush=True)
PY
