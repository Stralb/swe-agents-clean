#!/bin/bash
#SBATCH --job-name=rl-stage-study
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=00:06:00
set -euo pipefail
umask 077
TARGET=/home-mscluster/astrauss/research_artifacts/mcp_uploads/jobs/rl_coursework_completion_20261027/experiments/run_matched_study.py
mkdir -p "$(dirname "$TARGET")"
python3 - "$TARGET" <<'PY'
import base64,hashlib,zlib,sys
encoded=""
raw=zlib.decompress(base64.b64decode(encoded))
assert hashlib.sha256(raw).hexdigest()=="5c0a2ac44064824ac75e111896fa4638044d43258727ec904d4c767e0a05b679"
open(sys.argv[1],"wb").write(raw)
print('STAGED_STUDY_SOURCE',len(raw),hashlib.sha256(raw).hexdigest(),flush=True)
PY
python3 -m py_compile "$TARGET"
